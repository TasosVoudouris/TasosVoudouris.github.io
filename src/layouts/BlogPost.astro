---
import type { ImageMetadata } from 'astro';

import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

import { getTopicByName } from '../data/topics';
import { getSeriesByName } from '../data/series';
import { slugify } from '../utils/slugify';

import 'katex/dist/katex.min.css';

interface NavItem {
	id: string;
	title: string;
}

interface Props {
	title: string;
	description: string;
	pubDate?: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata;
	topics?: string[];
	tags?: string[];
	difficulty?: 'Introductory' | 'Intermediate' | 'Advanced';
	status?: 'Reviewed' | 'Validated' | 'Reference' | 'Research Note' | 'Experimental';
	series?: string;
	seriesOrder?: number;
	draft?: boolean;
	sourcePath?: string;
	previous?: NavItem;
	next?: NavItem;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	topics = [],
	tags = [],
	difficulty,
	status,
	series,
	seriesOrder,
	sourcePath,
	previous,
	next,
} = Astro.props;

const seriesDefinition = series ? getSeriesByName(series) : undefined;
const sourceUrl = sourcePath
	? `https://github.com/TasosVoudouris/TasosVoudouris.github.io/tree/main/${sourcePath}`
	: undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>

	<body>
		<Header />

		<main>
			<header class="article-header">
				<a class="back" href={seriesDefinition ? `/series/${seriesDefinition.slug}/` : '/blog/'}>
					{seriesDefinition ? `← ${seriesDefinition.name}` : '← All Articles'}
				</a>

				<div class="meta-top">
					{difficulty && <span>{difficulty}</span>}
					{status && <span class="separator">·</span>}
					{status && <span>{status}</span>}
					{(difficulty || status) && series && <span class="separator">·</span>}
					{seriesDefinition && (
						<a class="series-link" href={`/series/${seriesDefinition.slug}/`}>
							{seriesDefinition.name}{seriesOrder !== undefined ? ` / Part ${String(seriesOrder).padStart(2, '0')}` : ''}
						</a>
					)}
				</div>

				<h1>{title}</h1>
				<p class="description">{description}</p>

				{topics.length > 0 && (
					<div class="topic-links">
						{topics.map((topicName) => {
							const topic = getTopicByName(topicName);
							return (
								<a href={`/topics/${topic?.slug ?? slugify(topicName)}/`}>{topicName}</a>
							);
						})}
					</div>
				)}

				{(pubDate || updatedDate) && (
					<div class="publication">
						{pubDate && (
							<time datetime={pubDate.toISOString()}>
								Published {pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
							</time>
						)}
						{updatedDate && (
							<time datetime={updatedDate.toISOString()}>
								Updated {updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
							</time>
						)}
					</div>
				)}

				{tags.length > 0 && (
					<div class="tags">
						{tags.map((tag) => <a href={`/tags/${slugify(tag)}/`}>#{tag}</a>)}
					</div>
				)}

				{sourceUrl && (
					<a class="source-link" href={sourceUrl} target="_blank" rel="noreferrer">
						Companion implementation / source code ↗
					</a>
				)}
			</header>

			<div class="article-shell">
				<article class="prose"><slot /></article>
			</div>

			{seriesDefinition && (previous || next) && (
				<nav class="series-navigation" aria-label={`${seriesDefinition.name} article navigation`}>
					{previous ? (
						<a class="series-nav-item previous" href={`/blog/${previous.id}/`}>
							<span>← PREVIOUS</span>
							<strong>{previous.title}</strong>
						</a>
					) : <span />}
					{next && (
						<a class="series-nav-item next" href={`/blog/${next.id}/`}>
							<span>NEXT →</span>
							<strong>{next.title}</strong>
						</a>
					)}
				</nav>
			)}
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		padding-top: 2.5rem;
	}

	/* ---------------- header block */
	.article-header {
		max-width: 50rem;
		margin: 0 auto 3rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--line);
	}
	.back {
		display: inline-block;
		margin-bottom: 1.8rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--fg-dim);
		text-decoration: none;
	}
	.back:hover {
		color: var(--green);
	}
	.meta-top {
		display: flex;
		flex-wrap: wrap;
		gap: 0.2rem 0.5rem;
		margin-bottom: 1rem;
		font-family: var(--font-mono);
		font-size: 0.74rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--fg-faint);
	}
	.meta-top .separator {
		color: var(--line-strong);
	}
	.series-link {
		color: var(--green);
		text-decoration: none;
	}
	.series-link:hover {
		text-decoration: underline;
	}
	h1 {
		font-size: clamp(1.8rem, 1.2rem + 2.2vw, 2.6rem);
		line-height: 1.18;
		margin-bottom: 1rem;
	}
	.description {
		font-size: 1.12rem;
		color: var(--fg-dim);
		max-width: var(--measure);
		margin-bottom: 1.4rem;
	}
	.topic-links,
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 0.6rem;
		margin-bottom: 1rem;
	}
	.topic-links a {
		font-family: var(--font-mono);
		font-size: 0.76rem;
		padding: 0.2rem 0.55rem;
		border: 1px solid var(--line-strong);
		border-radius: var(--radius);
		color: var(--fg);
		text-decoration: none;
	}
	.topic-links a:hover {
		border-color: var(--green);
		color: var(--green);
	}
	.tags a {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		color: var(--fg-faint);
		text-decoration: none;
	}
	.tags a:hover {
		color: var(--green);
	}
	.publication {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 1.4rem;
		margin-bottom: 0.8rem;
		font-family: var(--font-mono);
		font-size: 0.76rem;
		color: var(--fg-faint);
	}
	.source-link {
		display: inline-block;
		margin-top: 0.4rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
	}

	/* ---------------- prose */
	.article-shell {
		max-width: 50rem;
		margin: 0 auto;
	}
	/* prose styles: see .prose in src/styles/global.css */

	/* ---------------- previous / next */
	.series-navigation {
		max-width: 50rem;
		margin: 4rem auto 0;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}
	.series-nav-item {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		padding: 1.1rem 1.2rem;
		background: var(--bg-raised);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		text-decoration: none;
		color: var(--fg);
	}
	.series-nav-item:hover {
		border-color: var(--green-dim);
	}
	.series-nav-item span {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		color: var(--green);
	}
	.series-nav-item strong {
		font-family: var(--font-mono);
		font-size: 0.92rem;
		line-height: 1.4;
	}
	.series-nav-item.next {
		text-align: right;
		grid-column: 2;
	}

	@media (max-width: 720px) {
		.series-navigation {
			grid-template-columns: 1fr;
		}
		.series-nav-item.next {
			grid-column: 1;
		}
	}
</style>
