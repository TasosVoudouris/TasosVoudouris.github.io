---
import type { ImageMetadata } from 'astro';

import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

import { getTopicByName } from '../data/topics';
import { getSeriesByName } from '../data/series';
import { slugify } from '../utils/slugify';

import 'katex/dist/katex.min.css';

interface NavItem {
	id: string;
	title: string;
}

interface Props {
	title: string;
	description: string;
	pubDate?: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata;
	topics?: string[];
	tags?: string[];
	difficulty?: 'Introductory' | 'Intermediate' | 'Advanced';
	status?: 'Reviewed' | 'Validated' | 'Reference' | 'Research Note' | 'Experimental';
	series?: string;
	seriesOrder?: number;
	draft?: boolean;
	sourcePath?: string;
	previous?: NavItem;
	next?: NavItem;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	topics = [],
	tags = [],
	difficulty,
	status,
	series,
	seriesOrder,
	sourcePath,
	previous,
	next,
} = Astro.props;

const seriesDefinition = series ? getSeriesByName(series) : undefined;
const sourceUrl = sourcePath
	? `https://github.com/TasosVoudouris/TasosVoudouris.github.io/tree/main/${sourcePath}`
	: undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>

	<body>
		<Header />

		<main>
			<header class="article-header">
				<a class="back" href={seriesDefinition ? `/series/${seriesDefinition.slug}/` : '/blog/'}>
					{seriesDefinition ? `← ${seriesDefinition.name}` : '← All Articles'}
				</a>

				<div class="meta-top">
					{difficulty && <span>{difficulty}</span>}
					{status && <span class="separator">·</span>}
					{status && <span>{status}</span>}
					{(difficulty || status) && series && <span class="separator">·</span>}
					{seriesDefinition && (
						<a class="series-link" href={`/series/${seriesDefinition.slug}/`}>
							{seriesDefinition.name}{seriesOrder !== undefined ? ` / Part ${String(seriesOrder).padStart(2, '0')}` : ''}
						</a>
					)}
				</div>

				<h1>{title}</h1>
				<p class="description">{description}</p>

				{topics.length > 0 && (
					<div class="topic-links">
						{topics.map((topicName) => {
							const topic = getTopicByName(topicName);
							return (
								<a href={`/topics/${topic?.slug ?? slugify(topicName)}/`}>{topicName}</a>
							);
						})}
					</div>
				)}

				{(pubDate || updatedDate) && (
					<div class="publication">
						{pubDate && (
							<time datetime={pubDate.toISOString()}>
								Published {pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
							</time>
						)}
						{updatedDate && (
							<time datetime={updatedDate.toISOString()}>
								Updated {updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
							</time>
						)}
					</div>
				)}

				{tags.length > 0 && (
					<div class="tags">
						{tags.map((tag) => <a href={`/tags/${slugify(tag)}/`}>#{tag}</a>)}
					</div>
				)}

				{sourceUrl && (
					<a class="source-link" href={sourceUrl} target="_blank" rel="noreferrer">
						Companion implementation / source code ↗
					</a>
				)}
			</header>

			<div class="article-shell">
				<article class="prose"><slot /></article>
			</div>

			{seriesDefinition && (previous || next) && (
				<nav class="series-navigation" aria-label={`${seriesDefinition.name} article navigation`}>
					{previous ? (
						<a class="series-nav-item previous" href={`/blog/${previous.id}/`}>
							<span>← PREVIOUS</span>
							<strong>{previous.title}</strong>
						</a>
					) : <span />}
					{next && (
						<a class="series-nav-item next" href={`/blog/${next.id}/`}>
							<span>NEXT →</span>
							<strong>{next.title}</strong>
						</a>
					)}
				</nav>
			)}
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
	}


	/* ----------------------------------------------- */
	/* ARTICLE HEADER                                  */
	/* ----------------------------------------------- */

	.article-header {
		width: min(900px, calc(100% - 3rem));

		margin: 0 auto;

		padding: 6rem 0 4rem;

		border-bottom: 1px solid #e5e7eb;
	}


	.back {
		display: inline-block;

		margin-bottom: 3rem;

		font-size: 0.85rem;
		font-weight: 600;

		color: #6b7280;

		text-decoration: none;
	}


	.back:hover {
		color: #4f46e5;
	}


	.meta-top {
		display: flex;
		align-items: center;
		flex-wrap: wrap;

		gap: 0.5rem;

		font-size: 0.72rem;
		font-weight: 700;

		letter-spacing: 0.1em;
		text-transform: uppercase;

		color: #9ca3af;
	}


	.category {
		color: #4f46e5;

		text-decoration: none;
	}


	.category:hover {
		text-decoration: underline;
	}


	.separator {
		color: #d1d5db;
	}


	h1 {
		margin: 1rem 0 1.5rem;

		font-size: clamp(3rem, 7vw, 5.5rem);
		line-height: 1;

		letter-spacing: -0.05em;

		color: #111827;
	}


	.description {
		max-width: 760px;

		margin: 0;

		font-size: 1.15rem;
		line-height: 1.8;

		color: #6b7280;
	}


	/* ----------------------------------------------- */
	/* PUBLICATION INFORMATION                         */
	/* ----------------------------------------------- */

	.publication {
		display: flex;
		flex-wrap: wrap;

		gap: 1.2rem;

		margin-top: 2rem;

		font-family: monospace;
		font-size: 0.75rem;

		color: #9ca3af;
	}



	.source-link {
		display: inline-block;
		margin-top: 1.4rem;
		font-family: monospace;
		font-size: 0.76rem;
		font-weight: 700;
		color: #4f46e5;
		text-decoration: none;
	}

	.source-link:hover { text-decoration: underline; }

	/* ----------------------------------------------- */
	/* TAGS                                            */
	/* ----------------------------------------------- */

	.tags {
		display: flex;
		flex-wrap: wrap;

		gap: 0.5rem;

		margin-top: 1.4rem;
	}


	.tags a {
		padding: 0.3rem 0.55rem;

		border: 1px solid #e5e7eb;
		border-radius: 4px;

		font-family: monospace;
		font-size: 0.72rem;

		color: #6b7280;

		text-decoration: none;

		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}


	.tags a:hover {
		border-color: #4f46e5;

		color: #4f46e5;
	}


	/* ----------------------------------------------- */
	/* ARTICLE BODY                                    */
	/* ----------------------------------------------- */

	.article-shell {
		width: min(900px, calc(100% - 3rem));

		margin: 0 auto;

		padding: 4rem 0 8rem;
	}


	.prose {
		font-size: 1.06rem;
		line-height: 1.85;

		color: #252a34;
	}


	.prose :global(p) {
		margin: 1.3rem 0;
	}


	.prose :global(h2) {
		margin: 3.5rem 0 1rem;

		font-size: clamp(2rem, 4vw, 2.8rem);
		line-height: 1.15;

		letter-spacing: -0.035em;

		color: #111827;
	}


	.prose :global(h3) {
		margin: 2.8rem 0 1rem;

		font-size: 1.6rem;

		letter-spacing: -0.02em;

		color: #111827;
	}


	.prose :global(h4) {
		margin: 2rem 0 0.8rem;

		font-size: 1.2rem;

		color: #111827;
	}


	.prose :global(strong) {
		color: #111827;
	}


	.prose :global(a) {
		color: #4f46e5;

		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}


	.prose :global(blockquote) {
		margin: 2rem 0;

		padding: 1rem 1.5rem;

		border-left: 3px solid #4f46e5;

		background: #f9fafb;

		color: #4b5563;
	}


	/* ----------------------------------------------- */
	/* CODE                                            */
	/* ----------------------------------------------- */

	.prose :global(code) {
		padding: 0.15rem 0.35rem;

		border-radius: 4px;

		background: #f3f4f6;

		font-size: 0.9em;
	}


	.prose :global(pre) {
		overflow-x: auto;

		margin: 2rem 0;

		padding: 1.4rem;

		border-radius: 8px;
	}


	.prose :global(pre code) {
		padding: 0;

		background: transparent;
	}


	/* ----------------------------------------------- */
	/* LISTS                                           */
	/* ----------------------------------------------- */

	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.6rem;

		margin: 1.4rem 0;
	}


	.prose :global(li) {
		margin: 0.45rem 0;
	}


	.prose :global(hr) {
		margin: 3rem 0;

		border: 0;
		border-top: 1px solid #e5e7eb;
	}


	/* ----------------------------------------------- */
	/* KATEX                                           */
	/* ----------------------------------------------- */

	.prose :global(.katex-display) {
		overflow-x: auto;
		overflow-y: hidden;

		margin: 2rem 0;

		padding: 0.5rem 0;
	}


	/* ----------------------------------------------- */
	/* MOBILE                                          */
	/* ----------------------------------------------- */

	@media (max-width: 700px) {

		.article-header {
			padding: 4rem 0 3rem;
		}


		.article-shell {
			padding: 3rem 0 6rem;
		}


		.prose {
			font-size: 1rem;
		}

	}

	.series-link { color: #4f46e5; text-decoration: none; }
	.series-link:hover { text-decoration: underline; }

	.topic-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		margin: 1.5rem 0 0;
	}

	.topic-links a {
		padding: 0.42rem 0.7rem;
		border: 1px solid #d1d5db;
		border-radius: 999px;
		font-size: 0.72rem;
		font-weight: 700;
		color: #374151;
		text-decoration: none;
	}

	.topic-links a:hover { border-color: #4f46e5; color: #4f46e5; }

	.series-navigation {
		width: min(900px, calc(100% - 3rem));
		margin: 0 auto 7rem;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.series-nav-item {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
		padding: 1.25rem;
		border: 1px solid #e5e7eb;
		text-decoration: none;
		color: #111827;
	}

	.series-nav-item.next { text-align: right; }
	.series-nav-item span { font-family: monospace; font-size: 0.68rem; color: #4f46e5; }
	.series-nav-item strong { font-size: 0.9rem; line-height: 1.45; }
	.series-nav-item:hover { border-color: #4f46e5; }

	@media (max-width: 700px) {
		.series-navigation { grid-template-columns: 1fr; }
		.series-nav-item.next { text-align: left; }
	}

</style>