---
import {
	GITHUB_URL,
	SOURCE_URL,
} from '../consts';

const year =
	new Date().getFullYear();
---

<footer class="site-footer">

	<div class="footer-inner">

		<div class="footer-left">

			<div class="footer-brand">

				<span class="footer-mark">
					C
				</span>

				<div>
					<p class="footer-title">
						CryptoCave
					</p>

					<p class="footer-node">
						RESEARCH NODE
					</p>
				</div>

			</div>

			<p class="footer-description">
				A living research notebook for modern cryptography,
				from mathematical foundations to protocols,
				implementations, and formal analysis.
			</p>

		</div>


		<div class="footer-right">

			<a href="/blog/">
				Articles
			</a>

			<a href="/topics/">
				Topics
			</a>

			<a href="/tags/">
				Tags
			</a>

			<a href="/about/">
				About
			</a>

			<a
				href={GITHUB_URL}
				target="_blank"
				rel="noopener noreferrer"
			>
				GitHub ↗
			</a>

			<a
				href={SOURCE_URL}
				target="_blank"
				rel="noopener noreferrer"
			>
				Source ↗
			</a>

		</div>

	</div>


	<div class="footer-bottom">

		<div class="footer-bottom-inner">

			<span>
				© {year} CryptoCave
			</span>

			<span>
				Research · Learn · Implement · Verify
			</span>

		</div>

	</div>

</footer>

<style>
	.site-footer {
		margin-top: 4rem;

		background: #fafafa;

		border-top: 1px solid #e5e7eb;
	}

	.footer-inner {
		width: min(1100px, calc(100% - 3rem));

		margin: 0 auto;

		padding: 4rem 0;

		display: flex;
		justify-content: space-between;

		gap: 4rem;
	}

	.footer-left {
		max-width: 500px;
	}

	.footer-brand {
		display: flex;
		align-items: center;

		gap: 0.8rem;
	}

	.footer-mark {
		width: 34px;
		height: 34px;

		display: flex;
		align-items: center;
		justify-content: center;

		border: 1px solid #d1d5db;

		font-family: monospace;
		font-weight: 700;

		color: #4f46e5;
	}

	.footer-title {
		margin: 0;

		font-size: 1.05rem;
		font-weight: 800;

		color: #111827;
	}

	.footer-node {
		margin: 0.15rem 0 0;

		font-family: monospace;
		font-size: 0.52rem;

		letter-spacing: 0.16em;

		color: #9ca3af;
	}

	.footer-description {
		margin: 1.2rem 0 0;

		line-height: 1.7;

		color: #6b7280;
	}

	.footer-right {
		display: flex;
		flex-wrap: wrap;

		align-content: flex-start;

		justify-content: flex-end;

		gap: 1rem 1.7rem;
	}

	.footer-right a {
		font-size: 0.85rem;
		font-weight: 600;

		color: #4b5563;

		text-decoration: none;
	}

	.footer-right a:hover {
		color: #4f46e5;
	}

	.footer-bottom {
		border-top: 1px solid #e5e7eb;
	}

	.footer-bottom-inner {
		width: min(1100px, calc(100% - 3rem));

		margin: 0 auto;

		padding: 1.2rem 0;

		display: flex;
		justify-content: space-between;

		gap: 1rem;

		font-family: monospace;
		font-size: 0.7rem;

		color: #9ca3af;
	}

	@media (max-width: 700px) {
		.footer-inner {
			flex-direction: column;
		}

		.footer-right {
			justify-content: flex-start;
		}

		.footer-bottom-inner {
			flex-direction: column;
		}
	}
</style>