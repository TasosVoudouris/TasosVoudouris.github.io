---
import { GITHUB_URL, SOURCE_URL } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="inner">
		<pre class="sig" aria-hidden="true">-- 
cryptocave :: research notebook
"don't trust, verify. then break it."</pre>

		<nav class="links" aria-label="Footer">
			<a href="/root/">root</a>
			<a href="/blog/">articles</a>
			<a href="/series/">series</a>
			<a href="/topics/">topics</a>
			<a href="/tags/">tags</a>
			<a href="/rss.xml">rss</a>
			<a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">github ↗</a>
			<a href={SOURCE_URL} target="_blank" rel="noopener noreferrer">source ↗</a>
		</nav>
	</div>
	<div class="bottom">
		<span>© {year} CryptoCave</span>
		<span>EOF</span>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--line);
		background: var(--bg-sunken);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--fg-dim);
	}
	.inner {
		width: var(--page);
		margin: 0 auto;
		padding: 2.2rem 0 1.6rem;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 1.5rem 3rem;
	}
	.sig {
		margin: 0;
		padding: 0;
		background: none !important;
		border: 0;
		font-size: 0.8rem;
		line-height: 1.6;
		color: var(--fg-faint);
		white-space: pre;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		align-content: flex-start;
		gap: 0.4rem 1.2rem;
	}
	.links a {
		color: var(--fg-dim);
		text-decoration: none;
	}
	.links a:hover {
		color: var(--green);
	}
	.bottom {
		width: var(--page);
		margin: 0 auto;
		padding: 0.9rem 0 1.4rem;
		display: flex;
		justify-content: space-between;
		border-top: 1px dashed var(--line);
		color: var(--fg-faint);
		font-size: 0.72rem;
	}
</style>
