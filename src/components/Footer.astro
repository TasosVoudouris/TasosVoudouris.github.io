---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-inner">

		<div class="footer-left">
			<p class="footer-title">CryptoCave</p>
			<p class="footer-description">
				Notes, research, and implementations in modern cryptography.
			</p>
		</div>

		<div class="footer-right">
			<a href="/blog/">Articles</a>
			<a href="/about/">About</a>
			<a
				href="https://github.com/"
				target="_blank"
				rel="noopener noreferrer"
			>
				GitHub
			</a>
		</div>

	</div>

	<div class="footer-bottom">
		<div class="footer-bottom-inner">
			<span>© {year} CryptoCave</span>
			<span>Built with Astro.</span>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 4rem;
		border-top: 1px solid #e5e7eb;
		background: #fafafa;
	}

	.footer-inner {
		width: min(1100px, calc(100% - 3rem));
		margin: 0 auto;
		padding: 4rem 0;

		display: flex;
		justify-content: space-between;
		gap: 3rem;
	}

	.footer-title {
		margin: 0;
		font-size: 1.2rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: #111827;
	}

	.footer-description {
		max-width: 450px;
		margin: 0.8rem 0 0;
		color: #6b7280;
		line-height: 1.7;
	}

	.footer-right {
		display: flex;
		gap: 2rem;
		align-items: flex-start;
	}

	.footer-right a {
		color: #4b5563;
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: none;
	}

	.footer-right a:hover {
		color: #4f46e5;
	}

	.footer-bottom {
		border-top: 1px solid #e5e7eb;
	}

	.footer-bottom-inner {
		width: min(1100px, calc(100% - 3rem));
		margin: 0 auto;
		padding: 1.2rem 0;

		display: flex;
		justify-content: space-between;

		font-size: 0.8rem;
		color: #9ca3af;
	}

	@media (max-width: 700px) {
		.footer-inner {
			flex-direction: column;
		}

		.footer-right {
			flex-wrap: wrap;
		}

		.footer-bottom-inner {
			flex-direction: column;
			gap: 0.4rem;
		}
	}
</style>