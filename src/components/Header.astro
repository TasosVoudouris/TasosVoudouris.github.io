---
import { SITE_TITLE } from '../consts';

const pathname = Astro.url.pathname;

const isHome = pathname === '/';

const isActive = (href: string) => {
	if (href === '/') return pathname === '/';

	return pathname.startsWith(href);
};
---

<header class:list={[
	'site-header',
	{ 'home-header': isHome },
]}>
	<div class="header-inner">

		<!-- ====================================================== -->
		<!-- BRAND                                                  -->
		<!-- ====================================================== -->

		<a
			class="brand"
			href="/"
			aria-label="CryptoCave home"
		>

			<div class="brand-symbol" aria-hidden="true">

				<span class="symbol-corner top-left"></span>
				<span class="symbol-corner top-right"></span>
				<span class="symbol-corner bottom-left"></span>
				<span class="symbol-corner bottom-right"></span>

				<span class="symbol-core">
					C
				</span>

				<span class="symbol-dot"></span>

			</div>


			<div class="brand-copy">

				<span class="brand-name">
					{SITE_TITLE}
				</span>

				<span class="brand-subtitle">
					RESEARCH NODE
				</span>

			</div>

		</a>


		<!-- ====================================================== -->
		<!-- NAVIGATION                                             -->
		<!-- ====================================================== -->

		<nav aria-label="Main navigation">

			<a
				href="/"
				class:list={[
					'nav-link',
					{ active: isActive('/') },
				]}
			>
				<span class="nav-index">00</span>
				Home
			</a>


			<a
				href="/blog/"
				class:list={[
					'nav-link',
					{ active: isActive('/blog/') },
				]}
			>
				<span class="nav-index">01</span>
				Articles
			</a>


			<a
				href="/topics/"
				class:list={[
					'nav-link',
					{ active: isActive('/topics/') },
				]}
			>
				<span class="nav-index">02</span>
				Topics
			</a>


			<a
				href="/tags/"
				class:list={[
					'nav-link',
					{ active: isActive('/tags/') },
				]}
			>
				<span class="nav-index">03</span>
				Tags
			</a>


			<a
				href="/about/"
				class:list={[
					'nav-link',
					{ active: isActive('/about/') },
				]}
			>
				<span class="nav-index">04</span>
				About
			</a>

		</nav>

	</div>
</header>


<style>

	/* ================================================== */
	/* HEADER                                             */
	/* ================================================== */

	.site-header {
		position: sticky;

		top: 0;

		z-index: 1000;

		width: 100%;

		background: rgba(255, 255, 255, 0.94);

		backdrop-filter: blur(18px);

		border-bottom: 1px solid #e5e7eb;
	}


	.header-inner {
		width: min(1240px, calc(100% - 3rem));

		height: 78px;

		margin: 0 auto;

		display: flex;
		align-items: center;
		justify-content: space-between;

		gap: 3rem;
	}


	/* ================================================== */
	/* BRAND                                              */
	/* ================================================== */

	.brand {
		display: flex;
		align-items: center;

		gap: 0.85rem;

		flex-shrink: 0;

		color: #111827;

		text-decoration: none;
	}


	.brand-symbol {
		position: relative;

		width: 38px;
		height: 38px;

		display: flex;
		align-items: center;
		justify-content: center;
	}


	.symbol-core {
		position: relative;

		z-index: 2;

		font-family:
			Consolas,
			'Courier New',
			monospace;

		font-size: 0.95rem;
		font-weight: 800;

		color: #4f46e5;
	}


	.symbol-dot {
		position: absolute;

		right: 2px;
		bottom: 2px;

		width: 5px;
		height: 5px;

		border-radius: 50%;

		background: #4f46e5;
	}


	.symbol-corner {
		position: absolute;

		width: 10px;
		height: 10px;

		border-color: #9ca3af;

		transition:
			border-color 0.2s ease,
			transform 0.2s ease;
	}


	.top-left {
		top: 0;
		left: 0;

		border-top: 1px solid;
		border-left: 1px solid;
	}


	.top-right {
		top: 0;
		right: 0;

		border-top: 1px solid;
		border-right: 1px solid;
	}


	.bottom-left {
		bottom: 0;
		left: 0;

		border-bottom: 1px solid;
		border-left: 1px solid;
	}


	.bottom-right {
		right: 0;
		bottom: 0;

		border-right: 1px solid;
		border-bottom: 1px solid;
	}


	.brand:hover .symbol-corner {
		border-color: #4f46e5;
	}


	.brand:hover .top-left,
	.brand:hover .bottom-right {
		transform: translate(-2px, -2px);
	}


	.brand:hover .top-right,
	.brand:hover .bottom-left {
		transform: translate(2px, 2px);
	}


	.brand-copy {
		display: flex;
		flex-direction: column;

		gap: 0.18rem;
	}


	.brand-name {
		font-size: 0.98rem;
		font-weight: 800;

		letter-spacing: -0.025em;
	}


	.brand-subtitle {
		font-family:
			Consolas,
			'Courier New',
			monospace;

		font-size: 0.52rem;

		letter-spacing: 0.17em;

		color: #9ca3af;
	}


	/* ================================================== */
	/* NAVIGATION                                         */
	/* ================================================== */

	nav {
		display: flex;
		align-items: stretch;

		height: 100%;

		gap: 1.8rem;
	}


	.nav-link {
		position: relative;

		display: flex;
		align-items: center;

		gap: 0.45rem;

		height: 100%;

		color: #6b7280;

		font-size: 0.84rem;
		font-weight: 600;

		text-decoration: none;

		transition: color 0.2s ease;
	}


	.nav-index {
		font-family:
			Consolas,
			'Courier New',
			monospace;

		font-size: 0.52rem;

		color: #c4c8cf;
	}


	.nav-link:hover {
		color: #111827;
	}


	.nav-link.active {
		color: #111827;
	}


	.nav-link.active .nav-index {
		color: #4f46e5;
	}


	.nav-link.active::after {
		content: '';

		position: absolute;

		left: 0;
		right: 0;

		bottom: -1px;

		height: 2px;

		background: #4f46e5;
	}


	/* ================================================== */
	/* DARK / HOMEPAGE MODE                               */
	/* ================================================== */

	.home-header {
		background:
			linear-gradient(
				to bottom,
				rgba(6, 8, 7, 0.98),
				rgba(6, 8, 7, 0.91)
			);

		border-bottom:
			1px solid rgba(88, 255, 138, 0.12);

		box-shadow:
			0 10px 40px rgba(0, 0, 0, 0.2);
	}


	.home-header .brand {
		color: #eef3ef;
	}


	.home-header .brand-subtitle {
		color: #4b5a50;
	}


	.home-header .symbol-core {
		color: #58ff8a;

		text-shadow:
			0 0 14px rgba(88, 255, 138, 0.32);
	}


	.home-header .symbol-dot {
		background: #58ff8a;

		box-shadow:
			0 0 8px rgba(88, 255, 138, 0.85);
	}


	.home-header .symbol-corner {
		border-color: #314138;
	}


	.home-header .brand:hover .symbol-corner {
		border-color: #58ff8a;
	}


	.home-header .nav-link {
		color: #626f67;
	}


	.home-header .nav-index {
		color: #344239;
	}


	.home-header .nav-link:hover {
		color: #dbe3dd;
	}


	.home-header .nav-link.active {
		color: #f0f5f1;
	}


	.home-header .nav-link.active .nav-index {
		color: #58ff8a;
	}


	.home-header .nav-link.active::after {
		background: #58ff8a;

		box-shadow:
			0 0 12px rgba(88, 255, 138, 0.45);
	}


	/* ================================================== */
	/* MOBILE                                             */
	/* ================================================== */

	@media (max-width: 820px) {

		.header-inner {
			width: calc(100% - 2rem);

			height: auto;

			padding: 0.9rem 0;

			align-items: flex-start;

			gap: 1rem;
		}


		.brand-symbol {
			width: 34px;
			height: 34px;
		}


		nav {
			height: auto;

			flex-wrap: wrap;
			justify-content: flex-end;

			gap: 0.65rem 1rem;
		}


		.nav-link {
			height: auto;

			padding: 0.25rem 0;

			font-size: 0.76rem;
		}


		.nav-link.active::after {
			bottom: -4px;
		}


		.nav-index {
			display: none;
		}

	}


	@media (max-width: 560px) {

		.brand-subtitle {
			display: none;
		}


		.brand-name {
			font-size: 0.9rem;
		}


		.header-inner {
			flex-direction: column;
			align-items: stretch;
		}


		.brand {
			align-self: flex-start;
		}


		nav {
			justify-content: space-between;

			width: 100%;
		}

	}

</style>