---
import { SITE_TITLE } from '../consts';

const pathname = Astro.url.pathname;

const isActive = (href: string) => {
	if (href === '/') return pathname === '/';
	return pathname.startsWith(href);
};
---

<header class="site-header">
	<div class="header-inner">

		<a class="brand" href="/">
			<span class="brand-mark">&gt;_</span>
			<span>{SITE_TITLE}</span>
		</a>

		<nav aria-label="Main navigation">

			<a
				href="/"
				class={isActive('/') ? 'nav-link active' : 'nav-link'}
			>
				Home
			</a>

			<a
				href="/blog/"
				class={isActive('/blog/') ? 'nav-link active' : 'nav-link'}
			>
				Articles
			</a>

			<a
				href="/topics/"
				class={isActive('/topics/') ? 'nav-link active' : 'nav-link'}
			>
				Topics
			</a>

			<a
				href="/tags/"
				class={isActive('/tags/') ? 'nav-link active' : 'nav-link'}
			>
				Tags
			</a>

			<a
				href="/about/"
				class={isActive('/about/') ? 'nav-link active' : 'nav-link'}
			>
				About
			</a>

		</nav>

	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;

		width: 100%;

		background: rgba(255, 255, 255, 0.92);
		backdrop-filter: blur(12px);

		border-bottom: 1px solid #e5e7eb;
	}

	.header-inner {
		width: min(1200px, calc(100% - 3rem));
		height: 72px;

		margin: 0 auto;

		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.brand {
		display: flex;
		align-items: center;

		gap: 0.6rem;

		color: #111827;

		font-size: 1.05rem;
		font-weight: 800;

		letter-spacing: -0.02em;

		text-decoration: none;
	}

	.brand-mark {
		font-family: monospace;
		font-size: 0.9rem;
		font-weight: 700;

		color: #4f46e5;
	}

	nav {
		display: flex;
		align-items: center;

		gap: 1.8rem;
	}

	.nav-link {
		position: relative;

		padding: 1.6rem 0;

		color: #6b7280;

		font-size: 0.9rem;
		font-weight: 600;

		text-decoration: none;

		transition: color 0.2s ease;
	}

	.nav-link:hover {
		color: #111827;
	}

	.nav-link.active {
		color: #111827;
	}

	.nav-link.active::after {
		content: '';

		position: absolute;

		left: 0;
		right: 0;
		bottom: -1px;

		height: 2px;

		background: #4f46e5;
	}

	@media (max-width: 700px) {
		.header-inner {
			width: calc(100% - 2rem);
			height: auto;

			padding: 1rem 0;

			align-items: flex-start;
			gap: 1rem;
		}

		nav {
			gap: 0.9rem;

			flex-wrap: wrap;
			justify-content: flex-end;
		}

		.nav-link {
			padding: 0.3rem 0;

			font-size: 0.78rem;
		}

		.nav-link.active::after {
			bottom: -4px;
		}
	}
</style>