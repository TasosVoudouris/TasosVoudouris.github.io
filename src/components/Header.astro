---
import { SITE_TITLE } from '../consts';

const pathname = Astro.url.pathname;

const links = [
	{ href: '/root/', label: 'root', root: true },
	{ href: '/library/', label: 'library' },
	{ href: '/blog/', label: 'articles' },
	{ href: '/series/', label: 'series' },
	{ href: '/topics/', label: 'topics' },
	{ href: '/tags/', label: 'tags' },
	{ href: '/about/', label: 'about' },
	{ href: '/about-me/', label: 'whoami' },
];

const asRoot = pathname.startsWith('/root/');

const isActive = (href: string) =>
	href === '/about/' ? pathname.startsWith('/about/') : pathname.startsWith(href);
---

<header class="site-header">
	<div class="bar">
		<a class="brand" href="/" aria-label={`${SITE_TITLE} home`}>
			<span class="prompt">[</span><span class:list={['user', { root: asRoot }]}>{asRoot ? 'root' : 'guest'}</span><span
				class="at">@</span
			><span class="host">cryptocave</span><span class="prompt">]</span><span class="dollar"
				>{asRoot ? '#' : '$'}</span
			><span class="cursor" aria-hidden="true"
			></span>
		</a>

		<nav class="nav" aria-label="Main navigation">
			{
				links.map((l) => (
					<a href={l.href} class:list={['nav-link', { active: isActive(l.href), root: l.root }]}>
						{l.label}
					</a>
				))
			}
		</nav>

		<details class="menu">
			<summary aria-label="Open menu">[ menu ]</summary>
			<nav aria-label="Main navigation (mobile)">
				<a href="/" class:list={['nav-link', { active: pathname === '/' }]}>~/</a>
				{
					links.map((l) => (
						<a href={l.href} class:list={['nav-link', { active: isActive(l.href) }]}>
							~/{l.label}
						</a>
					))
				}
			</nav>
		</details>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(7, 9, 7, 0.97);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--line);
	}
	.bar {
		width: var(--page);
		height: 3.6rem;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		font-family: var(--font-mono);
	}
	.brand {
		display: inline-flex;
		align-items: center;
		font-size: 0.92rem;
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
		color: var(--fg);
	}
	.brand .prompt {
		color: var(--fg-faint);
	}
	.brand .user {
		color: var(--fg-dim);
	}
	.brand .user.root {
		color: var(--red);
	}
	.brand .at {
		color: var(--fg-faint);
	}
	.brand .host {
		color: var(--green);
	}
	.brand .dollar {
		color: var(--fg-dim);
		margin-left: 0.15rem;
	}
	.cursor {
		display: inline-block;
		width: 0.55em;
		height: 1.05em;
		margin-left: 0.4em;
		background: var(--green);
		animation: blink 1.1s steps(1) infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	.nav {
		display: flex;
		gap: 0.15rem;
	}
	.nav-link {
		font-size: 0.82rem;
		padding: 0.3rem 0.55rem;
		color: var(--fg-dim);
		text-decoration: none;
		border-radius: var(--radius);
	}
	.nav-link::before {
		content: '/';
		color: var(--fg-faint);
	}
	.nav-link:hover {
		color: var(--fg-bright);
		background: var(--bg-raised);
	}
	.nav-link.active {
		color: var(--bg);
		background: var(--green);
	}
	.nav-link.active::before {
		color: var(--bg);
	}
	.nav-link.root {
		color: var(--red);
	}
	.nav-link.root::before {
		content: '#';
		color: var(--red);
	}
	.nav-link.root.active {
		color: var(--bg);
		background: var(--red);
	}
	.nav-link.root.active::before {
		color: var(--bg);
	}

	.menu {
		display: none;
		position: relative;
	}
	.menu summary {
		list-style: none;
		cursor: pointer;
		font-size: 0.82rem;
		color: var(--green);
		padding: 0.3rem 0;
	}
	.menu summary::-webkit-details-marker {
		display: none;
	}
	.menu[open] summary {
		color: var(--fg-bright);
	}
	.menu nav {
		position: absolute;
		right: 0;
		top: calc(100% + 0.9rem);
		min-width: 13rem;
		display: flex;
		flex-direction: column;
		padding: 0.5rem;
		background: var(--bg-raised);
		border: 1px solid var(--line-strong);
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7);
	}
	.menu .nav-link::before {
		content: none;
	}
	.menu .nav-link {
		padding: 0.5rem 0.6rem;
		font-size: 0.9rem;
	}

	@media (max-width: 860px) {
		.nav {
			display: none;
		}
		.menu {
			display: block;
		}
	}
</style>
