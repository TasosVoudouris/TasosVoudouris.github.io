---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import {
	SITE_TITLE,
	GITHUB_URL,
} from '../consts';

const LINKEDIN_URL =
	'https://www.linkedin.com/in/anastasis-voudouris-11724a11b/';

/*
 * Add the exact Google Scholar profile URL here when ready.
 *
 * Example:
 * const GOOGLE_SCHOLAR_URL =
 *   'https://scholar.google.com/citations?user=...';
 */
const GOOGLE_SCHOLAR_URL = 'https://scholar.google.com/citations?user=kU5Xb5kAAAAJ&hl=el';
---

<!doctype html>
<html lang="en">

	<head>
		<BaseHead
			title={`About Me | ${SITE_TITLE}`}
			description="About Anastasis Voudouris, the researcher behind CryptoCave."
		/>
	</head>

	<body>

		<Header />

		<main>

			<!-- ================================================== -->
			<!-- HERO                                               -->
			<!-- ================================================== -->

			<section class="hero">

				<div class="hero-copy">

					<p class="eyebrow">
						ABOUT ME
					</p>

					<h1>
						Anastasis
						<span>Voudouris.</span>
					</h1>

					<p class="intro">
						PhD Candidate at the University of Piraeus,
						working in cryptography, cybersecurity,
						and the study of modern cryptographic systems.
					</p>

				</div>


				<div class="portrait-shell">

					<div class="portrait-placeholder">

						<span class="portrait-mark">
							AV
						</span>

						<span class="portrait-label">
							PHOTO COMING SOON
						</span>

					</div>

				</div>

			</section>


			<!-- ================================================== -->
			<!-- WHO I AM                                           -->
			<!-- ================================================== -->

			<section class="content">

				<div class="section-number">
					01
				</div>

				<div>

					<p class="label">
						WHO I AM
					</p>

					<h2>
						Researching cryptography
						from theory to implementation.
					</h2>

					<p>
						I am a PhD Candidate at the University of Piraeus
						with a research focus on cryptography and cybersecurity.
					</p>

					<p>
						My interests span the mathematical foundations of
						cryptography, modern cryptographic protocols,
						threshold and distributed cryptography,
						post-quantum cryptography, zero-knowledge proofs,
						secure implementations, and the analysis of
						cryptographic systems.
					</p>

					<p>
						I am particularly interested in understanding not only
						how a construction works, but why it works, which
						assumptions it relies on, how those assumptions appear
						in code, and what can go wrong when a theoretical
						construction becomes a real implementation.
					</p>

				</div>

			</section>


			<!-- ================================================== -->
			<!-- CRYPTOCAVE                                         -->
			<!-- ================================================== -->

			<section class="content">

				<div class="section-number">
					02
				</div>

				<div>

					<p class="label">
						WHY I BUILT CRYPTOCAVE
					</p>

					<h2>
						A place to keep digging.
					</h2>

					<p>
						CryptoCave grew from research notes, implementations,
						experiments, old coursework, debugging sessions,
						papers, and questions that accumulated while studying
						cryptography.
					</p>

					<p>
						Instead of leaving that material scattered across
						different repositories and notebooks, I wanted to build
						a single place where it could be reorganized,
						corrected, expanded, implemented, and connected.
					</p>

					<p>
						The objective is not to present cryptography as a
						collection of black-box algorithms. The objective is
						to follow ideas from mathematical foundations to
						protocol design, implementation, failure cases,
						cryptanalysis, and current research.
					</p>

				</div>

			</section>


			<!-- ================================================== -->
			<!-- RESEARCH INTERESTS                                 -->
			<!-- ================================================== -->

			<section class="content">

				<div class="section-number">
					03
				</div>

				<div>

					<p class="label">
						RESEARCH INTERESTS
					</p>

					<h2>
						What I am currently exploring.
					</h2>

					<div class="interest-grid">

						<span>Applied Cryptography</span>
						<span>Threshold Cryptography</span>

						<span>Post-Quantum Cryptography</span>
						<span>Zero-Knowledge Proofs</span>

						<span>Secure Multiparty Computation</span>
						<span>Public-Key Infrastructure</span>

						<span>Cryptographic Implementations</span>
						<span>Formal & Security Analysis</span>

						<span>Elliptic-Curve Cryptography</span>
						<span>Lattice-Based Cryptography</span>

					</div>

				</div>

			</section>


			<!-- ================================================== -->
			<!-- PROFILES                                           -->
			<!-- ================================================== -->

			<section class="content">

				<div class="section-number">
					04
				</div>

				<div>

					<p class="label">
						PROFILES
					</p>

					<h2>
						Research and code elsewhere.
					</h2>

					<div class="profile-grid">

						<a
							class="profile-card"
							href={GITHUB_URL}
							target="_blank"
							rel="noopener noreferrer"
						>

							<span class="profile-type">
								CODE
							</span>

							<strong>
								GitHub
							</strong>

							<span class="profile-handle">
								@TasosVoudouris
							</span>

							<span class="profile-arrow">
								↗
							</span>

						</a>


						<a
							class="profile-card"
							href={LINKEDIN_URL}
							target="_blank"
							rel="noopener noreferrer"
						>

							<span class="profile-type">
								NETWORK
							</span>

							<strong>
								LinkedIn
							</strong>

							<span class="profile-handle">
								Anastasis Voudouris
							</span>

							<span class="profile-arrow">
								↗
							</span>

						</a>


						{
							GOOGLE_SCHOLAR_URL ? (

								<a
									class="profile-card"
									href={GOOGLE_SCHOLAR_URL}
									target="_blank"
									rel="noopener noreferrer"
								>

									<span class="profile-type">
										PUBLICATIONS
									</span>

									<strong>
										Google Scholar
									</strong>

									<span class="profile-handle">
										Research profile
									</span>

									<span class="profile-arrow">
										↗
									</span>

								</a>

							) : (

								<div class="profile-card profile-card-disabled">

									<span class="profile-type">
										PUBLICATIONS
									</span>

									<strong>
										Google Scholar
									</strong>

									<span class="profile-handle">
										Profile link coming soon
									</span>

								</div>

							)
						}

					</div>

				</div>

			</section>


			<!-- ================================================== -->
			<!-- CLOSING                                            -->
			<!-- ================================================== -->

			<section class="closing">

				<p>
					Research begins with
					<strong>questions.</strong>
				</p>

				<p>
					Understanding comes from
					<strong>digging deeper.</strong>
				</p>

			</section>

		</main>

		<Footer />

	</body>

</html>


<style>
	main {
		max-width: 60rem;
	}
	.hero {
		padding: 1rem 0 3rem;
		margin-bottom: 1rem;
		border-bottom: 1px solid var(--line);
	}
	.hero h1 {
		max-width: 22ch;
	}
	.hero h1::before {
		content: '> ';
		color: var(--green);
	}
	.hero h1 span {
		display: block;
		color: var(--green);
	}
	.content {
		display: grid;
		grid-template-columns: 3.5rem minmax(0, 1fr);
		gap: 1rem;
		padding: 2.6rem 0;
		border-bottom: 1px dashed var(--line);
	}
	.section-number {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--green);
		padding-top: 0.15rem;
	}
	.section-number::before {
		content: '0x';
		color: var(--fg-faint);
	}
	.content h2 {
		font-size: 1.35rem;
	}
	.content p:not(.label) {
		color: var(--fg);
		max-width: var(--measure);
	}
	.scope-grid,
	.interest-grid {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-top: 0.5rem;
	}
	.scope-grid span,
	.interest-grid span {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		padding: 0.3rem 0.65rem;
		border: 1px solid var(--line-strong);
		border-radius: var(--radius);
		color: var(--fg);
	}
	.scope-grid span:nth-child(odd),
	.interest-grid span:nth-child(odd) {
		color: var(--green);
	}
	.closing {
		padding: 3.5rem 0 1rem;
		font-family: var(--font-mono);
		color: var(--fg-dim);
	}
	.closing p {
		font-size: 1.3rem;
		line-height: 1.45;
	}
	.closing strong {
		color: var(--green);
	}
	.github {
		font-family: var(--font-mono);
	}
	@media (max-width: 640px) {
		.content {
			grid-template-columns: 1fr;
			gap: 0.4rem;
		}
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 2rem;
		align-items: end;
	}
	.portrait-shell {
		width: 11rem;
	}
	.portrait-placeholder {
		aspect-ratio: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		border: 1px solid var(--line-strong);
		background:
			repeating-linear-gradient(0deg, transparent 0 3px, rgba(57, 226, 125, 0.04) 3px 4px),
			var(--bg-raised);
	}
	.portrait-mark {
		font-family: var(--font-mono);
		font-size: 2.4rem;
		font-weight: 700;
		color: var(--green);
	}
	.portrait-label {
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.14em;
		color: var(--fg-faint);
	}
	.profile-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
		gap: 0.6rem;
		margin-top: 0.6rem;
	}
	.profile-card {
		display: grid;
		grid-template-columns: 1fr auto;
		grid-template-rows: auto auto auto;
		column-gap: 0.6rem;
		padding: 1rem 1.1rem;
		background: var(--bg-raised);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		color: var(--fg);
		text-decoration: none;
	}
	a.profile-card:hover {
		border-color: var(--green-dim);
	}
	.profile-type {
		font-family: var(--font-mono);
		font-size: 0.64rem;
		letter-spacing: 0.14em;
		color: var(--fg-faint);
	}
	.profile-card strong {
		font-family: var(--font-mono);
		font-size: 1rem;
	}
	a.profile-card:hover strong {
		color: var(--green);
	}
	.profile-handle {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--fg-dim);
	}
	.profile-arrow {
		grid-column: 2;
		grid-row: 1 / span 3;
		align-self: center;
		color: var(--green);
	}
	.profile-card-disabled {
		opacity: 0.55;
	}
	@media (max-width: 640px) {
		.hero {
			grid-template-columns: 1fr;
		}
	}
</style>