---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

import { SITE_TITLE } from '../../consts';
import { SERIES } from '../../data/series';
import { getTopicByName } from '../../data/topics';
import { sortSeries } from '../../utils/content';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
	return SERIES.map((series) => ({
		params: { slug: series.slug },
		props: {
			series,
			posts: sortSeries(posts.filter((post) => post.data.series === series.name)),
		},
	}));
}

type Props = {
	series: (typeof SERIES)[number];
	posts: CollectionEntry<'blog'>[];
};

const { series, posts } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${series.name} | ${SITE_TITLE}`} description={series.description} />
	</head>
	<body>
		<Header />
		<main>
			<section class="page-header">
				<a class="back" href="/series/">← All Series</a>
				<p class="eyebrow">ORDERED LEARNING PATH</p>
				<h1>{series.name}</h1>
				<p class="intro">{series.description}</p>
				<p class="count">{posts.length} articles · read top to bottom</p>
			</section>

			<section class="articles-section">
				<div class="articles">
					{posts.map((post) => {
						const primaryTopic = getTopicByName(post.data.topics[0]);
						return (
							<article class="article">
								<div class="number">{String(post.data.seriesOrder ?? 0).padStart(2, '0')}</div>
								<div class="content">
									<div class="meta">
										<span>{post.data.difficulty}</span>
										{post.data.status && <><span>·</span><span>{post.data.status}</span></>}
										{primaryTopic && <><span>·</span><a href={`/topics/${primaryTopic.slug}/`}>{primaryTopic.name}</a></>}
									</div>
									<h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
									<p class="description">{post.data.description}</p>
									<div class="topic-list">
										{post.data.topics.map((name) => {
											const topic = getTopicByName(name);
											return topic && <a href={`/topics/${topic.slug}/`}>{name}</a>;
										})}
									</div>
								</div>
							</article>
						);
					})}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.article .meta span:nth-child(even) {
		color: var(--line-strong);
	}
</style>
