---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

import { SITE_TITLE } from '../../consts';
import { SERIES } from '../../data/series';
import { getTopicByName } from '../../data/topics';
import { sortSeries } from '../../utils/content';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
	return SERIES.map((series) => ({
		params: { slug: series.slug },
		props: {
			series,
			posts: sortSeries(posts.filter((post) => post.data.series === series.name)),
		},
	}));
}

type Props = {
	series: (typeof SERIES)[number];
	posts: CollectionEntry<'blog'>[];
};

const { series, posts } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${series.name} | ${SITE_TITLE}`} description={series.description} />
	</head>
	<body>
		<Header />
		<main>
			<section class="page-header">
				<a class="back" href="/series/">← All Series</a>
				<p class="eyebrow">ORDERED LEARNING PATH</p>
				<h1>{series.name}</h1>
				<p class="intro">{series.description}</p>
				<p class="count">{posts.length} articles · read top to bottom</p>
			</section>

			<section class="articles-section">
				<div class="articles">
					{posts.map((post) => {
						const primaryTopic = getTopicByName(post.data.topics[0]);
						return (
							<article class="article">
								<div class="number">{String(post.data.seriesOrder ?? 0).padStart(2, '0')}</div>
								<div class="content">
									<div class="meta">
										<span>{post.data.difficulty}</span>
										{post.data.status && <><span>·</span><span>{post.data.status}</span></>}
										{primaryTopic && <><span>·</span><a href={`/topics/${primaryTopic.slug}/`}>{primaryTopic.name}</a></>}
									</div>
									<h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
									<p class="description">{post.data.description}</p>
									<div class="topic-list">
										{post.data.topics.map((name) => {
											const topic = getTopicByName(name);
											return topic && <a href={`/topics/${topic.slug}/`}>{name}</a>;
										})}
									</div>
								</div>
							</article>
						);
					})}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main { width: 100%; }
	.page-header, .articles-section { width: min(1100px, calc(100% - 3rem)); margin: 0 auto; }
	.page-header { padding: 6rem 0 4rem; border-bottom: 1px solid #e5e7eb; }
	.back { display: inline-block; margin-bottom: 3rem; font-size: 0.85rem; font-weight: 600; color: #6b7280; text-decoration: none; }
	.back:hover { color: #4f46e5; }
	.eyebrow { margin: 0; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.13em; color: #4f46e5; }
	h1 { max-width: 980px; margin: 0.7rem 0 1.2rem; font-size: clamp(3rem, 7vw, 6rem); line-height: 0.98; letter-spacing: -0.05em; color: #111827; }
	.intro { max-width: 820px; margin: 0; font-size: 1.05rem; line-height: 1.75; color: #6b7280; }
	.count { margin: 1.5rem 0 0; font-family: monospace; font-size: 0.78rem; color: #9ca3af; }
	.articles-section { padding: 4rem 0 7rem; }
	.articles { border-top: 1px solid #d1d5db; }
	.article { display: grid; grid-template-columns: 80px 1fr; gap: 2rem; padding: 2.5rem 0; border-bottom: 1px solid #d1d5db; }
	.number { font-family: monospace; font-size: 0.8rem; color: #4f46e5; padding-top: 0.2rem; }
	.meta { display: flex; flex-wrap: wrap; gap: 0.5rem; font-family: monospace; font-size: 0.72rem; color: #9ca3af; text-transform: uppercase; }
	.meta a { color: #4f46e5; text-decoration: none; }
	h2 { margin: 0.7rem 0 0.8rem; font-size: clamp(1.5rem, 3vw, 2.25rem); line-height: 1.16; letter-spacing: -0.025em; }
	h2 a { color: #111827; text-decoration: none; }
	h2 a:hover { color: #4f46e5; }
	.description { max-width: 820px; margin: 0; line-height: 1.7; color: #6b7280; }
	.topic-list { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.2rem; }
	.topic-list a { padding: 0.32rem 0.55rem; border: 1px solid #e5e7eb; border-radius: 999px; font-size: 0.68rem; font-weight: 700; color: #6b7280; text-decoration: none; }
	.topic-list a:hover { border-color: #4f46e5; color: #4f46e5; }
	@media (max-width: 650px) { .article { grid-template-columns: 1fr; gap: 0.6rem; } }
</style>
