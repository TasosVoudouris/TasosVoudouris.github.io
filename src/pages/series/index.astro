---
import { getCollection } from 'astro:content';

import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

import { SITE_TITLE } from '../../consts';
import { SERIES, SERIES_GROUPS } from '../../data/series';
import { sortSeries } from '../../utils/content';

const posts = (await getCollection('blog')).filter((post) => !post.data.draft);

const seriesData = SERIES.map((series) => {
	const entries = sortSeries(posts.filter((post) => post.data.series === series.name));
	return { ...series, entries };
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Series | ${SITE_TITLE}`}
			description="Ordered CryptoCave learning paths, reference tracks, and cryptanalysis deep dives."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="page-header">
				<p class="eyebrow">READ IN ORDER</p>
				<h1>Series</h1>
				<p class="intro">
					Topics tell you what an article is about. Series tell you what to read next.
					The paths below separate beginner progression, detailed reference material,
					core primitives, algebraic systems, distributed cryptography, and focused cryptanalysis.
				</p>
			</section>

			<section class="series-section">
				{SERIES_GROUPS.map((group, groupIndex) => {
					const groupSeries = seriesData.filter((series) => series.group === group);
					return (
						<section class="series-group">
							<div class="group-heading">
								<span>{String(groupIndex + 1).padStart(2, '0')}</span>
								<h2>{group}</h2>
							</div>
							<div class="group-series">
								{groupSeries.map((series, index) => (
									<a class="series-card" href={`/series/${series.slug}/`}>
										<div class="number">{String(index + 1).padStart(2, '0')}</div>
										<div class="content">
											<p class="label">ORDERED PATH</p>
											<h3>{series.name}</h3>
											<p>{series.description}</p>
											<div class="meta">
												<span>{series.entries.length} articles</span>
												<span>{series.startLabel} →</span>
											</div>
										</div>
									</a>
								))}
							</div>
						</section>
					);
				})}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main { width: 100%; }
	.page-header, .series-section { width: min(1100px, calc(100% - 3rem)); margin: 0 auto; }
	.page-header { padding: 7rem 0 5rem; border-bottom: 1px solid #e5e7eb; }
	.eyebrow, .label { margin: 0; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase; color: #4f46e5; }
	h1 { margin: 0.7rem 0 1.2rem; font-size: clamp(3.5rem, 8vw, 7rem); line-height: 0.95; letter-spacing: -0.055em; color: #111827; }
	.intro { max-width: 800px; margin: 0; font-size: 1.1rem; line-height: 1.8; color: #6b7280; }
	.series-section { padding: 4rem 0 7rem; }
	.series-group + .series-group { margin-top: 5rem; }
	.group-heading { display: flex; align-items: baseline; gap: 1rem; padding-bottom: 1.2rem; border-bottom: 1px solid #111827; }
	.group-heading span { font-family: monospace; font-size: 0.72rem; color: #9ca3af; }
	.group-heading h2 { margin: 0; font-size: 1rem; letter-spacing: 0.08em; text-transform: uppercase; color: #111827; }
	.series-card { display: grid; grid-template-columns: 80px 1fr; gap: 2rem; padding: 2.7rem 0; border-bottom: 1px solid #d1d5db; color: inherit; text-decoration: none; }
	.number { font-family: monospace; font-size: 0.8rem; color: #9ca3af; padding-top: 0.35rem; }
	h3 { margin: 0.55rem 0 1rem; font-size: clamp(1.8rem, 4vw, 3rem); line-height: 1.03; letter-spacing: -0.04em; color: #111827; }
	.content > p:not(.label) { max-width: 800px; margin: 0; line-height: 1.75; color: #6b7280; }
	.meta { display: flex; justify-content: space-between; gap: 1rem; margin-top: 1.6rem; font-family: monospace; font-size: 0.76rem; color: #4f46e5; }
	.series-card:hover h3 { color: #4f46e5; }
	@media (max-width: 650px) { .series-card { grid-template-columns: 1fr; gap: 0.7rem; } .number { display: none; } .meta { flex-direction: column; } .group-heading { align-items: flex-start; flex-direction: column; gap: 0.35rem; } }
</style>
