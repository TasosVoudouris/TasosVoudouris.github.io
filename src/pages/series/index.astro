---
import { getCollection } from 'astro:content';

import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

import { SITE_TITLE } from '../../consts';
import { SERIES, SERIES_GROUPS } from '../../data/series';
import { sortSeries } from '../../utils/content';

const posts = (await getCollection('blog')).filter((post) => !post.data.draft);

const seriesData = SERIES.map((series) => {
	const entries = sortSeries(posts.filter((post) => post.data.series === series.name));
	return { ...series, entries };
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Series | ${SITE_TITLE}`}
			description="Ordered CryptoCave learning paths, reference tracks, and cryptanalysis deep dives."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="page-header">
				<p class="eyebrow">READ IN ORDER</p>
				<h1>Series</h1>
				<p class="intro">
					Topics tell you what an article is about. Series tell you what to read next.
					The paths below separate beginner progression, detailed reference material,
					core primitives, algebraic systems, distributed cryptography, and focused cryptanalysis.
				</p>
			</section>

			<section class="series-section">
				{SERIES_GROUPS.map((group, groupIndex) => {
					const groupSeries = seriesData.filter((series) => series.group === group);
					return (
						<section class="series-group">
							<div class="group-heading">
								<span>{String(groupIndex + 1).padStart(2, '0')}</span>
								<h2>{group}</h2>
							</div>
							<div class="group-series">
								{groupSeries.map((series, index) => (
									<a class="series-card" href={`/series/${series.slug}/`}>
										<div class="number">{String(index + 1).padStart(2, '0')}</div>
										<div class="content">
											<p class="label">ORDERED PATH</p>
											<h3>{series.name}</h3>
											<p>{series.description}</p>
											<div class="meta">
												<span>{series.entries.length} articles</span>
												<span>{series.startLabel} →</span>
											</div>
										</div>
									</a>
								))}
							</div>
						</section>
					);
				})}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.series-group {
		margin-bottom: 3.2rem;
	}
	.group-heading {
		justify-content: flex-start;
		gap: 0.8rem;
	}
	.group-heading > span {
		color: var(--green);
	}
	.group-series {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(22rem, 1fr));
		gap: 0.7rem;
	}
	.series-card {
		display: grid;
		grid-template-columns: 2.2rem minmax(0, 1fr);
		gap: 0.6rem;
		padding: 1.2rem 1.2rem 1.1rem 1rem;
	}
	.series-card .number {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--fg-faint);
	}
	.series-card .label {
		font-size: 0.64rem;
		color: var(--fg-faint);
		margin-bottom: 0.4rem;
	}
	.series-card h3 {
		font-size: 1rem;
		margin-bottom: 0.4rem;
	}
	.series-card p {
		color: var(--fg-dim);
		font-size: 0.9rem;
		margin-bottom: 0.8rem;
	}
	.series-card .meta {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--fg-faint);
	}
	.series-card .meta span:last-child {
		color: var(--green);
	}
	@media (max-width: 520px) {
		.group-series {
			grid-template-columns: 1fr;
		}
	}
</style>
