---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CryptoBackdrop from '../components/CryptoBackdrop.astro';

import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

import { getCollection } from 'astro:content';

import { TOPICS, getTopicByName } from '../data/topics';
import { slugify } from '../utils/slugify';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort(
		(a, b) =>
			b.data.pubDate.valueOf() - a.data.pubDate.valueOf() ||
			b.id.localeCompare(a.id),
	)
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={SITE_TITLE}
			description={SITE_DESCRIPTION}
		/>
	</head>

	<body>
		<Header />

		<main class="home">

			<section class="hero">

				<CryptoBackdrop />

				<div class="hero-inner">

					<div class="terminal-line">
						<span class="terminal-prompt">&gt;</span>

						<span>
							initializing cryptographic research environment
						</span>

						<span class="cursor"></span>
					</div>

					<p class="eyebrow">
						CRYPTOCAVE / RESEARCH NODE
					</p>

					<h1>
						Enter the
						<span class="accent">
							CryptoCave.
						</span>
					</h1>

					<p class="hero-statement">
						Exploring cryptography from
						<span>mathematical structure</span>
						to
						<span>real protocols.</span>
					</p>

					<p class="intro">
						A growing technical archive of notes, research,
						implementations, experiments, and deeper questions
						across modern cryptography.
					</p>

					<div class="actions">

						<a
							class="primary"
							href="/blog/"
						>
							<span>
								Explore the Cave
							</span>

							<span class="button-arrow">
								→
							</span>
						</a>

						<a
							class="secondary"
							href="/topics/"
						>
							Browse Research Map
						</a>

					</div>

					<div class="hero-meta">

						<div>
							<span class="meta-label">
								MODE
							</span>

							<span class="meta-value">
								RESEARCH
							</span>
						</div>

						<div>
							<span class="meta-label">
								FOCUS
							</span>

							<span class="meta-value">
								CRYPTOGRAPHY
							</span>
						</div>

						<div>
							<span class="meta-label">
								STATUS
							</span>

							<span class="meta-value online">
								<span class="status-dot"></span>
								ONLINE
							</span>
						</div>

					</div>

				</div>

			</section>


			<section class="manifesto">

				<div class="manifesto-inner">

					<p class="section-code">
						01 / PRINCIPLE
					</p>

					<p class="manifesto-text">
						Do not stop at
						<span>how</span>
						a cryptographic construction works.
						Ask
						<span>why</span>
						it works, what structure enables it,
						and what breaks when the assumptions change.
					</p>

				</div>

			</section>


			<section class="section latest-section">

				<div class="section-heading">

					<div>
						<p class="section-code">
							02 / LATEST TRANSMISSIONS
						</p>

						<h2>
							Recent Research Notes
						</h2>
					</div>

					<a
						class="section-link"
						href="/blog/"
					>
						ALL ARTICLES →
					</a>

				</div>


				<div class="articles">

					{
						posts.map((post, index) => {
							const topic = getTopicByName(
								post.data.category,
							);

							return (

								<article class="article">

									<div class="article-index">
										{String(index + 1).padStart(2, '0')}
									</div>

									<div class="article-main">

										<div class="article-meta">

											<a
												class="category"
												href={`/topics/${topic?.slug ?? slugify(post.data.category)}/`}
											>
												{post.data.category}
											</a>

											<span>/</span>

											<span>
												{post.data.difficulty}
											</span>

										</div>

										<h3>
											<a href={`/blog/${post.id}/`}>
												{post.data.title}
											</a>
										</h3>

										<p class="article-description">
											{post.data.description}
										</p>

										<div class="article-footer">

											<div class="tags">

												{
													post.data.tags
														.slice(0, 4)
														.map((tag) => (

															<a href={`/tags/${slugify(tag)}/`}>
																#{tag}
															</a>

														))
												}

											</div>

											<time
												datetime={post.data.pubDate.toISOString()}
											>
												{
													post.data.pubDate.toLocaleDateString(
														'en-US',
														{
															year: 'numeric',
															month: 'short',
															day: 'numeric',
														},
													)
												}
											</time>

										</div>

									</div>

									<a
										class="article-arrow"
										href={`/blog/${post.id}/`}
									>
										↗
									</a>

								</article>

							);
						})
					}

				</div>

			</section>


			<section class="section topics-section">

				<div class="section-heading">

					<div>

						<p class="section-code">
							03 / KNOWLEDGE MAP
						</p>

						<h2>
							Explore the Cave
						</h2>

					</div>

					<a
						class="section-link"
						href="/topics/"
					>
						ALL TOPICS →
					</a>

				</div>

				<div class="topics">

					{
						TOPICS.map((topic, index) => (

							<a
								class="topic"
								href={`/topics/${topic.slug}/`}
							>

								<div class="topic-number">
									{String(index + 1).padStart(2, '0')}
								</div>

								<div class="topic-content">

									<h3>
										{topic.name}
									</h3>

									<p>
										{topic.description}
									</p>

								</div>

								<span class="topic-arrow">
									→
								</span>

							</a>

						))
					}

				</div>

			</section>


			<section class="signal">

				<div class="signal-inner">

					<div class="signal-code">
						<span></span>
						ACTIVE RESEARCH SIGNAL
					</div>

					<h2>
						From algebra to
						<span>zero knowledge.</span><br />

						From theory to
						<span>implementation.</span>
					</h2>

					<p>
						CryptoCave is built as a living research notebook:
						concepts connect, questions evolve, implementations
						are tested, and ideas are refined over time.
					</p>

					<div class="signal-links">

						<a href="/blog/">
							Read Articles →
						</a>

						<a href="/topics/">
							Explore Topics →
						</a>

						<a href="/tags/">
							Browse Concepts →
						</a>

					</div>

				</div>

			</section>

		</main>

		<Footer />
	</body>
</html>

<style>
	.home {
		--bg: #060807;
		--green: #58ff8a;
		--green-bright: #8affaa;
		--green-dim: #239b4b;
		--text: #f2f5f3;
		--muted: #8d9891;
		--line: rgba(88, 255, 138, 0.13);

		width: 100%;

		background:
			radial-gradient(
				circle at 50% -10%,
				rgba(39, 143, 74, 0.14),
				transparent 42%
			),
			var(--bg);

		color: var(--text);
	}

	.hero {
		position: relative;

		min-height: calc(100vh - 78px);

		display: flex;
		align-items: center;

		overflow: hidden;

		border-bottom:
			1px solid var(--line);
	}

	.hero-inner {
		position: relative;

		z-index: 5;

		width: min(1180px, calc(100% - 3rem));

		margin: 0 auto;

		padding: 7rem 0 6rem;
	}

	.terminal-line {
		display: flex;
		align-items: center;

		gap: 0.65rem;

		margin-bottom: 3rem;

		font-family: monospace;
		font-size: 0.72rem;

		letter-spacing: 0.08em;

		color: #5e7365;
	}

	.terminal-prompt {
		color: var(--green);
	}

	.cursor {
		width: 6px;
		height: 13px;

		background: var(--green);

		animation: blink 1.1s infinite;
	}

	@keyframes blink {
		0%,
		45% {
			opacity: 1;
		}

		46%,
		100% {
			opacity: 0;
		}
	}

	.eyebrow,
	.section-code {
		margin: 0;

		font-family: monospace;
		font-size: 0.7rem;
		font-weight: 700;

		letter-spacing: 0.15em;

		color: var(--green);
	}

	.hero h1 {
		max-width: 950px;

		margin: 1rem 0 0;

		font-size: clamp(4rem, 10vw, 9rem);

		line-height: 0.88;

		letter-spacing: -0.075em;

		color: #f5f7f6;

		text-shadow:
			0 4px 40px rgba(0, 0, 0, 0.45);
	}

	.hero h1 .accent {
		display: block;

		color: var(--green);

		text-shadow:
			0 0 35px rgba(88, 255, 138, 0.19);
	}

	.hero-statement {
		max-width: 850px;

		margin: 2.4rem 0 0;

		font-size: clamp(1.4rem, 3vw, 2.2rem);

		line-height: 1.35;

		letter-spacing: -0.025em;

		color: #929b95;
	}

	.hero-statement span {
		color: #e8ece9;
	}

	.intro {
		max-width: 690px;

		margin: 1.8rem 0 0;

		line-height: 1.85;

		color: #68736c;
	}

	.actions {
		display: flex;

		gap: 1rem;

		margin-top: 3rem;
	}

	.actions a {
		display: inline-flex;
		align-items: center;

		gap: 1.5rem;

		padding: 0.95rem 1.25rem;

		font-family: monospace;
		font-size: 0.78rem;
		font-weight: 700;

		text-decoration: none;
	}

	.primary {
		background: var(--green);

		color: #041008;
	}

	.primary:hover {
		background: var(--green-bright);
	}

	.secondary {
		border:
			1px solid rgba(88, 255, 138, 0.18);

		color: #b2bbb5;

		background:
			rgba(255, 255, 255, 0.015);
	}

	.secondary:hover {
		border-color:
			rgba(88, 255, 138, 0.5);

		color: var(--green);
	}

	.hero-meta {
		display: flex;
		flex-wrap: wrap;

		gap: 3.5rem;

		margin-top: 4rem;

		padding-top: 2rem;

		border-top: 1px solid var(--line);
	}

	.hero-meta > div {
		display: flex;
		flex-direction: column;

		gap: 0.4rem;
	}

	.meta-label {
		font-family: monospace;
		font-size: 0.62rem;

		letter-spacing: 0.14em;

		color: #4b5550;
	}

	.meta-value {
		font-family: monospace;
		font-size: 0.75rem;

		color: #9da6a0;
	}

	.online {
		display: flex;
		align-items: center;

		gap: 0.5rem;

		color: var(--green);
	}

	.status-dot {
		width: 6px;
		height: 6px;

		border-radius: 50%;

		background: var(--green);

		box-shadow:
			0 0 10px var(--green);
	}

	.manifesto {
		border-bottom:
			1px solid var(--line);
	}

	.manifesto-inner,
	.section,
	.signal-inner {
		width: min(1180px, calc(100% - 3rem));

		margin: 0 auto;
	}

	.manifesto-inner {
		padding: 7rem 0;
	}

	.manifesto-text {
		max-width: 1000px;

		margin: 2rem 0 0;

		font-size: clamp(2rem, 5vw, 4.5rem);

		line-height: 1.08;

		letter-spacing: -0.045em;

		color: #4e5852;
	}

	.manifesto-text span {
		color: #f1f4f2;
	}

	.section {
		padding: 7rem 0;
	}

	.section-heading {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;

		gap: 3rem;

		margin-bottom: 3rem;
	}

	.section-heading h2 {
		margin: 0.7rem 0 0;

		font-size: clamp(2.5rem, 5vw, 4.5rem);

		line-height: 1;

		letter-spacing: -0.05em;

		color: #f1f4f2;
	}

	.section-link {
		font-family: monospace;
		font-size: 0.68rem;
		font-weight: 700;

		color: #657068;

		text-decoration: none;
	}

	.section-link:hover {
		color: var(--green);
	}

	.latest-section,
	.topics-section {
		border-bottom:
			1px solid var(--line);
	}

	.articles {
		border-top:
			1px solid var(--line);
	}

	.article {
		display: grid;
		grid-template-columns: 70px 1fr 50px;

		gap: 2rem;

		padding: 2.8rem 0;

		border-bottom:
			1px solid var(--line);
	}

	.article-index {
		font-family: monospace;

		color: #39443d;
	}

	.article-meta {
		display: flex;
		flex-wrap: wrap;

		gap: 0.6rem;

		font-family: monospace;
		font-size: 0.68rem;

		color: #526057;
	}

	.category {
		color: var(--green);

		text-decoration: none;
	}

	.article h3 {
		margin: 0.7rem 0 1rem;
	}

	.article h3 a {
		font-size: clamp(1.5rem, 3vw, 2.4rem);

		letter-spacing: -0.03em;

		color: #e7ebe8;

		text-decoration: none;
	}

	.article:hover h3 a {
		color: var(--green);
	}

	.article-description {
		max-width: 720px;

		margin: 0;

		line-height: 1.7;

		color: #68746c;
	}

	.article-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;

		gap: 2rem;

		margin-top: 1.5rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;

		gap: 0.5rem;
	}

	.tags a {
		padding: 0.25rem 0.5rem;

		border:
			1px solid var(--line);

		font-family: monospace;
		font-size: 0.68rem;

		color: #647068;

		text-decoration: none;
	}

	.tags a:hover {
		border-color: var(--green-dim);

		color: var(--green);
	}

	time {
		font-family: monospace;
		font-size: 0.7rem;

		color: #4b5650;
	}

	.article-arrow {
		align-self: center;

		font-size: 1.4rem;

		color: #354039;

		text-decoration: none;
	}

	.article:hover .article-arrow {
		color: var(--green);
	}

	.topics {
		display: grid;
		grid-template-columns: repeat(2, 1fr);

		border-top:
			1px solid var(--line);
	}

	.topic {
		display: grid;
		grid-template-columns:
			45px
			1fr
			30px;

		gap: 1.4rem;

		padding: 2rem;

		border-bottom:
			1px solid var(--line);

		color: inherit;

		text-decoration: none;
	}

	.topic:nth-child(odd) {
		border-right:
			1px solid var(--line);
	}

	.topic-number {
		font-family: monospace;
		font-size: 0.7rem;

		color: #354039;
	}

	.topic h3 {
		margin: 0;

		font-size: 1.15rem;

		color: #cfd5d1;
	}

	.topic p {
		max-width: 430px;

		margin: 0.7rem 0 0;

		font-size: 0.84rem;

		line-height: 1.6;

		color: #58645c;
	}

	.topic-arrow {
		color: #39443d;
	}

	.topic:hover {
		background:
			rgba(88, 255, 138, 0.018);
	}

	.topic:hover h3,
	.topic:hover .topic-arrow {
		color: var(--green);
	}

	.signal {
		position: relative;

		overflow: hidden;
	}

	.signal-inner {
		padding: 9rem 0;
	}

	.signal-code {
		display: flex;
		align-items: center;

		gap: 0.7rem;

		font-family: monospace;
		font-size: 0.68rem;

		color: #58645c;
	}

	.signal-code span {
		width: 7px;
		height: 7px;

		border-radius: 50%;

		background: var(--green);

		box-shadow:
			0 0 12px var(--green);
	}

	.signal h2 {
		max-width: 1000px;

		margin: 2rem 0 0;

		font-size: clamp(3rem, 7vw, 6.5rem);

		line-height: 0.95;

		letter-spacing: -0.06em;

		color: #e9edea;
	}

	.signal h2 span {
		color: var(--green);
	}

	.signal p {
		max-width: 700px;

		margin: 2.5rem 0 0;

		line-height: 1.8;

		color: #69756d;
	}

	.signal-links {
		display: flex;
		flex-wrap: wrap;

		gap: 2rem;

		margin-top: 3rem;
	}

	.signal-links a {
		font-family: monospace;
		font-size: 0.75rem;
		font-weight: 700;

		color: #98a29b;

		text-decoration: none;
	}

	.signal-links a:hover {
		color: var(--green);
	}

	@media (max-width: 800px) {
		.hero {
			min-height: auto;
		}

		.hero-inner {
			width: min(100% - 2rem, 1180px);

			padding: 5rem 0;
		}

		.manifesto-inner,
		.section,
		.signal-inner {
			width: min(100% - 2rem, 1180px);
		}

		.actions {
			flex-direction: column;
			align-items: flex-start;
		}

		.section-heading {
			flex-direction: column;
			align-items: flex-start;
		}

		.article {
			grid-template-columns: 1fr;
		}

		.article-index,
		.article-arrow {
			display: none;
		}

		.article-footer {
			flex-direction: column;
			align-items: flex-start;
		}

		.topics {
			grid-template-columns: 1fr;
		}

		.topic:nth-child(odd) {
			border-right: none;
		}
	}
</style>