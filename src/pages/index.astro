---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MatrixRain from '../components/MatrixRain.astro';

import { SITE_TITLE, SITE_DESCRIPTION, GITHUB_URL } from '../consts';
import { getCollection } from 'astro:content';
import { SERIES, SERIES_GROUPS } from '../data/series';
import { TOPICS, TOPIC_GROUPS, getTopicByName } from '../data/topics';
import { sortNewest } from '../utils/content';
import { ROOT_ROADMAP, ROOT_TAGLINE, ROOT_TITLE, partLabel } from '../data/root';
import { slugify } from '../utils/slugify';

const posts = sortNewest((await getCollection('blog')).filter((post) => !post.data.draft));
const latest = posts.slice(0, 8);
const lastUpdate = posts[0]?.data.pubDate;

const seriesRows = SERIES.map((series) => ({
	...series,
	count: posts.filter((post) => post.data.series === series.name).length,
}));
const topicRows = TOPICS.map((topic) => ({
	...topic,
	count: posts.filter((post) => post.data.topics.includes(topic.name)).length,
}));

const rootParts = (await getCollection('root'))
	.filter((p) => !p.data.draft)
	.sort((a, b) => a.data.part - b.data.part);

const BANNER = `                         __
  ____________  ______  / /_____  _________ __   _____
 / ___/ ___/ / / / __ \\/ __/ __ \\/ ___/ __ \`/ | / / _ \\
/ /__/ /  / /_/ / /_/ / /_/ /_/ / /__/ /_/ /| |/ /  __/
\\___/_/   \\__, / .___/\\__/\\____/\\___/\\__,_/ |___/\\___/
         /____/_/`;

const iso = (d: Date) => d.toISOString().slice(0, 10);
const pad = (n: number, w = 3) => String(n).padStart(w, ' ');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />

		<section class="hero">
			<MatrixRain />
			<div class="hero-shade" aria-hidden="true"></div>

			<div class="hero-inner">
				<h1 class="sr-only">CryptoCave</h1>
				<pre class="banner" aria-hidden="true">{BANNER}</pre>

				<div class="term">
					<p class="cmd"><span class="ps1">$</span> cat /etc/motd</p>
					<p class="out motd">
						Cryptography from first principles: the mathematics underneath,
						the constructions on top, the protocols in the wild, and the
						exact place where each one breaks.
					</p>

					<p class="cmd"><span class="ps1">$</span> whoami</p>
					<p class="out">
						<a href="/about-me/">anastasis voudouris</a>{' '}
						<span class="dim">::</span> phd candidate, university of piraeus{' '}
						<span class="dim">::</span> applied, threshold &amp; post-quantum cryptography
					</p>

					<p class="cmd"><span class="ps1">$</span> ls ~/</p>
					<nav class="out dirs" aria-label="Sections">
						<a href="/blog/">articles/</a>
						<a href="/series/">series/</a>
						<a href="/topics/">topics/</a>
						<a href="/library/">library/</a>
						<a href="/tags/">tags/</a>
					</nav>

					<p class="cmd"><span class="ps1">$</span> <span class="cursor" aria-hidden="true"></span></p>
				</div>

				<dl class="stats">
					<div><dt>articles</dt><dd>{posts.length}</dd></div>
					<div><dt>series</dt><dd>{SERIES.length}</dd></div>
					<div><dt>topics</dt><dd>{TOPICS.length}</dd></div>
					{lastUpdate && <div><dt>last write</dt><dd>{iso(lastUpdate)}</dd></div>}
				</dl>
			</div>
		</section>

		<main class="home">
			<!-- ------------------------------------------------ root of trust -->
			<section class="block rootblock">
				<p class="rcmd"><span class="ps1">$</span> sudo su -</p>
				<p class="rcmd"><span class="rps1">root@cryptocave:~#</span> cat /root/README</p>
				<div class="rootcard">
					<p class="rt">{ROOT_TITLE}</p>
					<p class="rtag"># {ROOT_TAGLINE}</p>
					<p class="rdesc">
						A long-form series on how the web decides whom to trust, why post-quantum signatures
						break that design, and how Merkle Tree Certificates fix it. From the bytes up, with
						hand-drawn figures and runnable code.
					</p>
					<ul class="rparts">
						{rootParts.map((p) => (
							<li>
								<span class="rn">{partLabel(p.data.part)}</span>
								<a href={`/root/${p.id}/`}>{p.data.title}</a>
							</li>
						))}
						<li class="rmore">
							<span class="rn">..</span>
							<a href="/root/">
								{ROOT_ROADMAP.length - rootParts.length} more parts on the roadmap: enter /root →
							</a>
						</li>
					</ul>
				</div>
			</section>

			<!-- ------------------------------------------------ latest -->
			<section class="block">
				<header class="block-head">
					<h2><span class="ps1">$</span> tail -n {latest.length} articles.log</h2>
					<a href="/blog/">all {posts.length} →</a>
				</header>

				<ol class="log">
					{
						latest.map((post) => {
							const topic = getTopicByName(post.data.topics[0]);
							return (
								<li>
									<time datetime={post.data.pubDate.toISOString()}>{iso(post.data.pubDate)}</time>
									<a class="topic" href={`/topics/${topic?.slug ?? slugify(post.data.topics[0])}/`}>
										[{post.data.topics[0]}]
									</a>
									<a class="title" href={`/blog/${post.id}/`}>
										{post.data.title}
									</a>
								</li>
							);
						})
					}
				</ol>
			</section>

			<!-- ------------------------------------------------ manifesto -->
			<section class="block">
				<pre class="manifesto">/*
 * Do not stop at <em>how</em> a cryptographic construction works.
 * Ask <em>why</em> it works, what structure enables it,
 * and what breaks when the assumptions change.
 */</pre>
			</section>

			<!-- ------------------------------------------------ series -->
			<section class="block">
				<header class="block-head">
					<h2><span class="ps1">$</span> ls -l ~/series</h2>
					<a href="/series/">read in order →</a>
				</header>

				<div class="series-groups">
					{
						SERIES_GROUPS.map((group) => (
							<div class="series-group">
								<p class="group-name"># {group}</p>
								<ul class="ls">
									{seriesRows
										.filter((s) => s.group === group)
										.map((s) => (
											<li>
												<span class="perm">drwxr-x---</span>
												<span class="num">{pad(s.count)}</span>
												<a href={`/series/${s.slug}/`}>{s.name}/</a>
											</li>
										))}
								</ul>
							</div>
						))
					}
				</div>
			</section>

			<!-- ------------------------------------------------ topics -->
			<section class="block">
				<header class="block-head">
					<h2><span class="ps1">$</span> grep -c topic *</h2>
					<a href="/topics/">topic map →</a>
				</header>

				<div class="topic-groups">
					{
						TOPIC_GROUPS.map((group) => (
							<div>
								<p class="group-name"># {group}</p>
								<ul class="topics">
									{topicRows
										.filter((t) => t.group === group)
										.map((t) => (
											<li>
												<a href={`/topics/${t.slug}/`}>{t.name}</a>
												<span class:list={['n', { zero: t.count === 0 }]}>{t.count}</span>
											</li>
										))}
								</ul>
							</div>
						))
					}
				</div>
			</section>

			<!-- ------------------------------------------------ closing -->
			<section class="block closing">
				<p>
					From algebra to zero knowledge.<br />
					From theory to <span class="hl">implementation</span>.<br />
					From implementation to the <span class="hl">attack</span>.
				</p>
				<p class="links">
					<a href="/series/cryptography-primer/">start here</a>
					<a href="/library/">full index</a>
					<a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">github ↗</a>
				</p>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	/* ------------------------------------------------ hero */
	.hero {
		position: relative;
		overflow: hidden;
		border-bottom: 1px solid var(--line);
		background: var(--bg-sunken);
	}
	.hero-shade {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			linear-gradient(90deg, rgba(4, 5, 4, 0.94) 0%, rgba(4, 5, 4, 0.7) 45%, rgba(4, 5, 4, 0.1) 100%),
			linear-gradient(0deg, var(--bg-sunken) 0%, transparent 30%);
	}
	.hero-inner {
		position: relative;
		width: var(--page);
		margin: 0 auto;
		padding: 4.5rem 0 3.5rem;
	}
	.banner {
		margin: 0 0 2.2rem;
		padding: 0;
		background: none !important;
		border: 0;
		color: var(--green);
		font-size: clamp(7px, 2.05vw, 15px);
		line-height: 1.15;
		font-weight: 700;
		text-shadow: 0 0 18px rgba(57, 226, 125, 0.35);
		overflow: visible;
	}

	.term {
		max-width: 46rem;
		font-family: var(--font-mono);
		font-size: 0.92rem;
	}
	.term p {
		margin: 0;
	}
	.cmd {
		color: var(--fg-bright);
		margin-top: 1rem !important;
	}
	.cmd:first-child {
		margin-top: 0 !important;
	}
	.ps1 {
		color: var(--green);
		margin-right: 0.15em;
	}
	.out {
		color: var(--fg-dim);
		padding-left: 1.2rem;
		line-height: 1.65;
	}
	.motd {
		font-family: var(--font-body);
		font-size: 1.12rem;
		color: var(--fg);
		max-width: 40rem;
	}
	.dim {
		color: var(--fg-faint);
	}
	.dirs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 1.3rem;
	}
	.dirs a {
		color: var(--green);
		font-weight: 600;
		text-decoration: none;
	}
	.dirs a:hover {
		color: var(--bg);
		background: var(--green);
	}
	.cursor {
		display: inline-block;
		width: 0.6em;
		height: 1.1em;
		vertical-align: text-bottom;
		background: var(--green);
		animation: blink 1.1s steps(1) infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	.stats {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin: 2.6rem 0 0;
		font-family: var(--font-mono);
	}
	.stats div {
		display: flex;
		gap: 0.6rem;
		align-items: baseline;
		padding: 0.4rem 0.8rem;
		border: 1px solid var(--line-strong);
		background: rgba(7, 9, 7, 0.75);
	}
	.stats dt {
		font-size: 0.7rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--fg-faint);
	}
	.stats dd {
		margin: 0;
		font-size: 0.92rem;
		color: var(--green);
	}

	/* ------------------------------------------------ root of trust */
	.rootblock {
		font-family: var(--font-mono);
	}
	.rcmd {
		margin: 0 0 0.2rem;
		font-size: 0.9rem;
		color: var(--fg-bright);
	}
	.rps1 {
		color: var(--red);
		font-weight: 600;
		margin-right: 0.3em;
	}
	.rootcard {
		margin-top: 1rem;
		padding: 1.6rem 1.8rem;
		border: 1px solid rgba(239, 107, 92, 0.35);
		background:
			linear-gradient(135deg, rgba(239, 107, 92, 0.06), transparent 60%),
			var(--bg-raised);
	}
	.rt {
		margin: 0;
		font-size: clamp(1.6rem, 1.1rem + 2vw, 2.4rem);
		font-weight: 700;
		color: var(--fg-bright);
		letter-spacing: -0.02em;
	}
	.rtag {
		margin: 0.2rem 0 1rem;
		color: var(--amber);
		font-size: 0.92rem;
	}
	.rdesc {
		font-family: var(--font-body);
		color: var(--fg);
		max-width: 44rem;
	}
	.rparts {
		list-style: none;
		margin: 0;
		padding: 0;
		font-size: 0.9rem;
	}
	.rparts li {
		display: flex;
		gap: 0.9rem;
		padding: 0.25rem 0;
	}
	.rn {
		color: var(--amber);
	}
	.rparts a {
		color: var(--fg-bright);
		text-decoration: none;
	}
	.rparts a:hover {
		color: var(--green);
	}
	.rmore a {
		color: var(--red);
	}

	/* ------------------------------------------------ blocks */
	.home {
		padding-top: 3.5rem;
	}
	.block {
		margin-bottom: 4.5rem;
	}
	.block-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.2rem;
		padding-bottom: 0.6rem;
		border-bottom: 1px dashed var(--line-strong);
		font-family: var(--font-mono);
	}
	.block-head h2 {
		margin: 0;
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: 0;
		color: var(--fg-bright);
	}
	.block-head a {
		font-size: 0.8rem;
		white-space: nowrap;
		text-decoration: none;
	}

	/* latest articles as a log */
	.log {
		list-style: none;
		margin: 0;
		padding: 0;
		font-family: var(--font-mono);
		font-size: 0.88rem;
	}
	.log li {
		display: grid;
		grid-template-columns: 6.6rem 15rem minmax(0, 1fr);
		gap: 1rem;
		padding: 0.55rem 0.4rem;
		border-bottom: 1px solid var(--line);
	}
	.log li:hover {
		background: var(--bg-raised);
	}
	.log time {
		color: var(--fg-faint);
	}
	.log .topic {
		color: var(--green-dim);
		text-decoration: none;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.log .topic:hover {
		color: var(--green);
	}
	.log .title {
		color: var(--fg-bright);
		text-decoration: none;
	}
	.log .title:hover {
		color: var(--green);
	}

	/* manifesto as a C comment */
	.manifesto {
		margin: 0;
		padding: 1.6rem 1.8rem;
		background: none !important;
		border: 0;
		border-left: 2px solid var(--amber);
		font-size: clamp(0.85rem, 0.7rem + 0.7vw, 1.2rem);
		line-height: 1.75;
		color: var(--fg-dim);
		white-space: pre-wrap;
	}
	.manifesto em {
		font-style: normal;
		color: var(--amber);
		font-weight: 700;
	}

	/* series as `ls -l` */
	.series-groups {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(25rem, 1fr));
		gap: 1.6rem 2.5rem;
	}
	.group-name {
		margin: 0 0 0.4rem;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--fg-faint);
	}
	.ls {
		list-style: none;
		margin: 0;
		padding: 0;
		font-family: var(--font-mono);
		font-size: 0.86rem;
	}
	.ls li {
		display: flex;
		gap: 0.9rem;
		padding: 0.12rem 0;
		white-space: nowrap;
	}
	.perm {
		color: var(--fg-faint);
	}
	.num {
		color: var(--fg-dim);
		white-space: pre;
	}
	.ls a {
		color: var(--green);
		text-decoration: none;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.ls a:hover {
		color: var(--bg);
		background: var(--green);
	}

	/* topics */
	.topic-groups {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
		gap: 1.6rem 2.5rem;
	}
	.topics {
		list-style: none;
		margin: 0;
		padding: 0;
		font-family: var(--font-mono);
		font-size: 0.84rem;
	}
	.topics li {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		padding: 0.1rem 0;
	}
	.topics li::after {
		content: '';
		order: 1;
		flex: 1;
		border-bottom: 1px dotted var(--line-strong);
	}
	.topics a {
		color: var(--fg);
		text-decoration: none;
	}
	.topics a:hover {
		color: var(--green);
	}
	.topics .n {
		order: 2;
		color: var(--green);
	}
	.topics .n.zero {
		color: var(--fg-faint);
	}

	/* closing */
	.closing {
		padding: 2rem 0 0;
		border-top: 1px solid var(--line);
	}
	.closing p:first-child {
		font-family: var(--font-mono);
		font-size: clamp(1.2rem, 0.9rem + 1.4vw, 1.9rem);
		font-weight: 700;
		line-height: 1.4;
		color: var(--fg-bright);
	}
	.hl {
		color: var(--green);
	}
	.closing .links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 1.4rem;
		font-family: var(--font-mono);
		font-size: 0.88rem;
	}
	.closing .links a::before {
		content: '-> ';
		color: var(--fg-faint);
	}

	@media (max-width: 860px) {
		.log li {
			grid-template-columns: 1fr;
			gap: 0.15rem;
			padding: 0.8rem 0.2rem;
		}
		.log .topic {
			font-size: 0.75rem;
		}
		.series-groups {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 520px) {
		.hero-inner {
			padding-top: 2.6rem;
		}
		.perm {
			display: none;
		}
		.ls li {
			white-space: normal;
		}
	}
</style>
