---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const slugify = (value: string): string =>
	value
		.toLowerCase()
		.trim()
		.replace(/&/g, 'and')
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-+|-+$/g, '');

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const topics = [
	{
		name: 'Mathematical Foundations',
		slug: 'mathematical-foundations',
	},
	{
		name: 'Number Theory',
		slug: 'number-theory',
	},
	{
		name: 'Symmetric Cryptography',
		slug: 'symmetric-cryptography',
	},
	{
		name: 'Public-Key Cryptography',
		slug: 'public-key-cryptography',
	},
	{
		name: 'Zero-Knowledge Proofs',
		slug: 'zero-knowledge-proofs',
	},
	{
		name: 'MPC',
		slug: 'mpc',
	},
	{
		name: 'Threshold Cryptography',
		slug: 'threshold-cryptography',
	},
	{
		name: 'Post-Quantum Cryptography',
		slug: 'post-quantum-cryptography',
	},
	{
		name: 'Formal Verification',
		slug: 'formal-verification',
	},
	{
		name: 'Implementations',
		slug: 'implementations',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={SITE_TITLE}
			description={SITE_DESCRIPTION}
		/>
	</head>

	<body>
		<Header />

		<main>

			<section class="hero">
				<div class="hero-inner">

					<p class="eyebrow">
						CRYPTOGRAPHY · THEORY · IMPLEMENTATION
					</p>

					<h1>
						Exploring Cryptography
						<span>
							from Foundations to Modern Protocols.
						</span>
					</h1>

					<p class="intro">
						CryptoCave is a technical notebook and research-oriented
						blog dedicated to understanding cryptography from the
						mathematics behind it to real implementations and modern
						protocols.
					</p>

					<div class="actions">
						<a
							class="primary"
							href="/blog/"
						>
							Explore Articles
						</a>

						<a
							class="secondary"
							href="https://github.com/"
							target="_blank"
							rel="noopener noreferrer"
						>
							View GitHub
						</a>
					</div>

				</div>
			</section>


			<section class="section">

				<div class="section-heading">
					<p>RECENT WRITING</p>
					<h2>Latest Notes & Articles</h2>
				</div>

				<div class="articles">
					{
						posts.map((post, index) => (
							<article class="article">

								<div class="number">
									{String(index + 1).padStart(2, '0')}
								</div>

								<div class="article-content">

									<div class="article-top">

										<a
											class="category"
											href={`/topics/${slugify(post.data.category)}/`}
										>
											{post.data.category}
										</a>

										<span class="separator">
											·
										</span>

										<span class="difficulty">
											{post.data.difficulty}
										</span>

									</div>

									<h3>
										<a
											class="article-title"
											href={`/blog/${post.id}/`}
										>
											{post.data.title}
										</a>
									</h3>

									<p class="description">
										{post.data.description}
									</p>

									<div class="article-bottom">

										<div class="tags">
											{
												post.data.tags
													.slice(0, 4)
													.map((tag) => (
														<span class="tag">
															#{tag}
														</span>
													))
											}
										</div>

										<time
											datetime={post.data.pubDate.toISOString()}
										>
											{
												post.data.pubDate.toLocaleDateString(
													'en-US',
													{
														year: 'numeric',
														month: 'short',
														day: 'numeric',
													},
												)
											}
										</time>

									</div>

								</div>

							</article>
						))
					}
				</div>

				<div class="view-all">
					<a href="/blog/">
						View all articles →
					</a>
				</div>

			</section>


			<section class="section topics-section">

				<div class="section-heading">
					<p>EXPLORE</p>
					<h2>Cryptography by Topic</h2>
				</div>

				<div class="topics">
					{
						topics.map((topic) => (
							<a href={`/topics/${topic.slug}/`}>
								<span>
									{topic.name}
								</span>

								<span class="topic-arrow">
									→
								</span>
							</a>
						))
					}
				</div>

				<div class="view-all">
					<a href="/topics/">
						Explore all topics →
					</a>
				</div>

			</section>


			<section class="closing">
				<p>
					The goal is not only to use cryptography,
					but to understand why it works.
				</p>
			</section>

		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
	}

	.hero-inner,
	.section,
	.closing {
		width: min(1100px, calc(100% - 3rem));
		margin: 0 auto;
	}

	.hero {
		min-height: 70vh;

		display: flex;
		align-items: center;

		border-bottom: 1px solid #e5e7eb;
	}

	.hero-inner {
		padding: 7rem 0;
	}

	.eyebrow,
	.section-heading > p {
		margin: 0;

		font-size: 0.75rem;
		font-weight: 700;

		letter-spacing: 0.15em;
		text-transform: uppercase;

		color: #4f46e5;
	}

	h1 {
		max-width: 900px;

		margin: 1rem 0 1.5rem;

		font-size: clamp(3rem, 7vw, 6.5rem);
		line-height: 0.98;

		letter-spacing: -0.055em;

		color: #111827;
	}

	h1 span {
		display: block;
		color: #6b7280;
	}

	.intro {
		max-width: 720px;

		margin: 0;

		font-size: 1.15rem;
		line-height: 1.8;

		color: #4b5563;
	}

	.actions {
		display: flex;

		gap: 1rem;

		margin-top: 2.5rem;
	}

	.actions a {
		padding: 0.85rem 1.3rem;

		border-radius: 6px;

		font-weight: 600;

		text-decoration: none;
	}

	.primary {
		background: #111827;
		color: #ffffff;
	}

	.primary:hover {
		background: #4f46e5;
	}

	.secondary {
		border: 1px solid #d1d5db;

		color: #111827;
	}

	.secondary:hover {
		border-color: #111827;
	}

	.section {
		padding: 6rem 0;
	}

	.section-heading {
		margin-bottom: 3rem;
	}

	.section-heading h2 {
		margin: 0.5rem 0 0;

		font-size: clamp(2rem, 4vw, 3.4rem);

		letter-spacing: -0.035em;

		color: #111827;
	}

	.articles {
		border-top: 1px solid #d1d5db;
	}

	.article {
		display: grid;
		grid-template-columns: 80px 1fr;

		gap: 2rem;

		padding: 2.5rem 0;

		border-bottom: 1px solid #d1d5db;
	}

	.number {
		padding-top: 0.2rem;

		font-family: monospace;
		font-size: 0.85rem;

		color: #9ca3af;
	}

	.article-content {
		width: 100%;
	}

	.article-top {
		display: flex;
		align-items: center;
		flex-wrap: wrap;

		gap: 0.5rem;

		margin-bottom: 0.5rem;

		font-size: 0.72rem;
		font-weight: 700;

		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.category {
		color: #4f46e5;
		text-decoration: none;
	}

	.category:hover {
		text-decoration: underline;
	}

	.separator {
		color: #d1d5db;
	}

	.difficulty {
		color: #9ca3af;
	}

	.article h3 {
		margin: 0.3rem 0 0.8rem;

		font-size: 1.65rem;
		line-height: 1.25;

		letter-spacing: -0.02em;
	}

	.article-title {
		color: #111827;

		text-decoration: none;

		transition: color 0.2s ease;
	}

	.article-title:hover {
		color: #4f46e5;
	}

	.description {
		max-width: 720px;

		margin: 0;

		line-height: 1.7;

		color: #6b7280;
	}

	.article-bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;

		gap: 1.5rem;

		margin-top: 1.4rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;

		gap: 0.5rem;
	}

	.tag {
		padding: 0.25rem 0.5rem;

		border: 1px solid #e5e7eb;
		border-radius: 4px;

		font-family: monospace;
		font-size: 0.72rem;

		color: #6b7280;
	}

	time {
		flex-shrink: 0;

		font-family: monospace;
		font-size: 0.75rem;

		color: #9ca3af;
	}

	.view-all {
		margin-top: 2rem;
	}

	.view-all a {
		font-size: 0.9rem;
		font-weight: 700;

		color: #111827;

		text-decoration: none;
	}

	.view-all a:hover {
		color: #4f46e5;
	}

	.topics-section {
		border-top: 1px solid #e5e7eb;
	}

	.topics {
		display: grid;
		grid-template-columns: repeat(2, 1fr);

		border-top: 1px solid #d1d5db;
	}

	.topics a {
		display: flex;
		align-items: center;
		justify-content: space-between;

		gap: 1rem;

		padding: 1.5rem 0;

		border-bottom: 1px solid #d1d5db;

		color: #111827;

		font-size: 1.05rem;
		font-weight: 600;

		text-decoration: none;

		transition: color 0.2s ease;
	}

	.topics a:nth-child(odd) {
		padding-right: 2rem;
	}

	.topics a:nth-child(even) {
		padding-left: 2rem;
	}

	.topics a:hover {
		color: #4f46e5;
	}

	.topic-arrow {
		font-family: monospace;

		color: #9ca3af;

		transition:
			transform 0.2s ease,
			color 0.2s ease;
	}

	.topics a:hover .topic-arrow {
		transform: translateX(4px);
		color: #4f46e5;
	}

	.closing {
		padding: 4rem 0 7rem;
	}

	.closing p {
		max-width: 800px;

		margin: 0;

		font-size: clamp(2rem, 5vw, 4rem);
		font-weight: 700;

		line-height: 1.1;

		letter-spacing: -0.04em;

		color: #111827;
	}

	@media (max-width: 700px) {
		.hero-inner {
			padding: 5rem 0;
		}

		.actions {
			flex-direction: column;
			align-items: flex-start;
		}

		.article {
			grid-template-columns: 1fr;

			gap: 0.8rem;
		}

		.number {
			display: none;
		}

		.article-bottom {
			flex-direction: column;
			align-items: flex-start;
		}

		.topics {
			grid-template-columns: 1fr;
		}

		.topics a:nth-child(odd),
		.topics a:nth-child(even) {
			padding-left: 0;
			padding-right: 0;
		}
	}
</style>