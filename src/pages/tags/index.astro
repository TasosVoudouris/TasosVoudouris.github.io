---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

import { SITE_TITLE } from '../../consts';

import { getCollection } from 'astro:content';

import { slugify } from '../../utils/slugify';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft);

const tagMap = new Map<string, number>();

for (const post of posts) {
	for (const tag of post.data.tags) {
		tagMap.set(
			tag,
			(tagMap.get(tag) ?? 0) + 1,
		);
	}
}

const tags = [...tagMap.entries()]
	.map(([name, count]) => ({
		name,
		slug: slugify(name),
		count,
	}))
	.sort((a, b) => {
		if (b.count !== a.count) {
			return b.count - a.count;
		}

		return a.name.localeCompare(b.name);
	});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Tags | ${SITE_TITLE}`}
			description="Browse CryptoCave articles by concept, primitive, protocol, and cryptographic keyword."
		/>
	</head>

	<body>
		<Header />

		<main>

			<section class="page-header">

				<p class="eyebrow">
					CONCEPT INDEX
				</p>

				<h1>Tags</h1>

				<p class="intro">
					Explore specific concepts appearing throughout CryptoCave.
					Topics describe broad areas of cryptography, while tags
					connect individual structures, primitives, techniques,
					protocols, and recurring ideas across different articles.
				</p>

			</section>


			<section class="tags-section">

				<div class="section-top">

					<p>ALL TAGS</p>

					<span>
						{tags.length}
						{tags.length === 1
							? ' tag'
							: ' tags'}
					</span>

				</div>


				<div class="tag-grid">

					{
						tags.map((tag) => (

							<a
								class="tag-card"
								href={`/tags/${tag.slug}/`}
							>

								<div class="tag-main">

									<span class="tag-name">
										#{tag.name}
									</span>

									<span class="tag-count">
										{tag.count}
										{tag.count === 1
											? ' article'
											: ' articles'}
									</span>

								</div>

								<span class="arrow">
									→
								</span>

							</a>

						))
					}

				</div>

			</section>

		</main>

		<Footer />
	</body>
</html>

<style>
	.tag-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
		gap: 0.5rem;
	}
	.tag-card {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.6rem;
		padding: 0.7rem 0.9rem;
	}
	.tag-main {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.tag-name {
		font-family: var(--font-mono);
		font-size: 0.86rem;
		color: var(--fg-bright);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.tag-count {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--fg-faint);
	}
	.arrow {
		color: var(--fg-faint);
	}
	.tag-card:hover .arrow {
		color: var(--green);
	}
</style>