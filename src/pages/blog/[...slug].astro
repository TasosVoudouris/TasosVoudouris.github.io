---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { sortSeries } from '../../utils/content';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).filter((post) => !post.data.draft);

	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);

const published = (await getCollection('blog')).filter((entry) => !entry.data.draft);
const siblings = post.data.series
	? sortSeries(published.filter((entry) => entry.data.series === post.data.series))
	: [];
const currentIndex = siblings.findIndex((entry) => entry.id === post.id);
const previous = currentIndex > 0 ? siblings[currentIndex - 1] : undefined;
const next = currentIndex >= 0 && currentIndex < siblings.length - 1 ? siblings[currentIndex + 1] : undefined;
---

<BlogPost
	{...post.data}
	previous={previous ? { id: previous.id, title: previous.data.title } : undefined}
	next={next ? { id: next.id, title: next.data.title } : undefined}
>
	<Content />
</BlogPost>
