---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import {
	SITE_TITLE,
	GITHUB_URL,
} from '../consts';
---

<!doctype html>
<html lang="en">

	<head>
		<BaseHead
			title={`About CryptoCave | ${SITE_TITLE}`}
			description="What CryptoCave is, why it exists, and how the project approaches cryptography."
		/>
	</head>

	<body>

		<Header />

		<main>

			<section class="hero">

				<p class="eyebrow">
					ABOUT CRYPTOCAVE
				</p>

				<h1>
					Cryptography deserves
					<span>deeper questions.</span>
				</h1>

				<p class="intro">
					CryptoCave is a living technical notebook for exploring
					cryptography from its mathematical foundations to modern
					protocols, implementations, experiments, and formal analysis.
				</p>

			</section>


			<section class="content">

				<div class="section-number">
					01
				</div>

				<div>
					<p class="label">
						WHY CRYPTOCAVE
					</p>

					<h2>
						Understanding before using.
					</h2>

					<p>
						Cryptographic constructions are often introduced
						as algorithms to apply: choose parameters, execute
						the protocol, obtain the result.
					</p>

					<p>
						CryptoCave takes a different approach. The objective
						is to understand the structure underneath the
						construction: why a particular algebraic setting is
						used, where the computational hardness comes from,
						which assumptions security depends on, and what changes
						when those assumptions are modified.
					</p>
				</div>

			</section>


			<section class="content">

				<div class="section-number">
					02
				</div>

				<div>
					<p class="label">
						THE SCOPE
					</p>

					<h2>
						From foundations to modern protocols.
					</h2>

					<div class="scope-grid">

						<span>Algebra</span>
						<span>Number Theory</span>
						<span>Symmetric Crypto</span>
						<span>Public-Key Crypto</span>
						<span>Zero Knowledge</span>
						<span>MPC</span>
						<span>Threshold Crypto</span>
						<span>Post-Quantum</span>
						<span>Formal Verification</span>
						<span>Implementations</span>

					</div>
				</div>

			</section>


			<section class="content">

				<div class="section-number">
					03
				</div>

				<div>
					<p class="label">
						THE METHOD
					</p>

					<h2>
						Theory. Implementation. Verification.
					</h2>

					<p>
						Articles are intended to connect mathematical intuition,
						formal reasoning, algorithms, code, experiments, and
						the current cryptographic research landscape.
					</p>

					<p>
						The site will continue to evolve as new questions,
						implementations, papers, experiments, and connections
						are explored.
					</p>

					<a
						class="github"
						href={GITHUB_URL}
						target="_blank"
						rel="noopener noreferrer"
					>
						Explore GitHub →
					</a>
				</div>

			</section>


			<section class="closing">

				<p>
					Do not stop at
					<strong>how.</strong>
				</p>

				<p>
					Keep asking
					<strong>why.</strong>
				</p>

			</section>

		</main>

		<Footer />

	</body>

</html>

<style>
	main {
		max-width: 60rem;
	}
	.hero {
		padding: 1rem 0 3rem;
		margin-bottom: 1rem;
		border-bottom: 1px solid var(--line);
	}
	.hero h1 {
		max-width: 22ch;
	}
	.hero h1::before {
		content: '> ';
		color: var(--green);
	}
	.hero h1 span {
		display: block;
		color: var(--green);
	}
	.content {
		display: grid;
		grid-template-columns: 3.5rem minmax(0, 1fr);
		gap: 1rem;
		padding: 2.6rem 0;
		border-bottom: 1px dashed var(--line);
	}
	.section-number {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--green);
		padding-top: 0.15rem;
	}
	.section-number::before {
		content: '0x';
		color: var(--fg-faint);
	}
	.content h2 {
		font-size: 1.35rem;
	}
	.content p:not(.label) {
		color: var(--fg);
		max-width: var(--measure);
	}
	.scope-grid,
	.interest-grid {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-top: 0.5rem;
	}
	.scope-grid span,
	.interest-grid span {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		padding: 0.3rem 0.65rem;
		border: 1px solid var(--line-strong);
		border-radius: var(--radius);
		color: var(--fg);
	}
	.scope-grid span:nth-child(odd),
	.interest-grid span:nth-child(odd) {
		color: var(--green);
	}
	.closing {
		padding: 3.5rem 0 1rem;
		font-family: var(--font-mono);
		color: var(--fg-dim);
	}
	.closing p {
		font-size: 1.3rem;
		line-height: 1.45;
	}
	.closing strong {
		color: var(--green);
	}
	.github {
		font-family: var(--font-mono);
	}
	@media (max-width: 640px) {
		.content {
			grid-template-columns: 1fr;
			gap: 0.4rem;
		}
	}
</style>