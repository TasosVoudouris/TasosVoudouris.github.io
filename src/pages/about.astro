---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import {
	SITE_TITLE,
	GITHUB_URL,
} from '../consts';
---

<!doctype html>
<html lang="en">

	<head>
		<BaseHead
			title={`About | ${SITE_TITLE}`}
			description="What CryptoCave is, why it exists, and how the project approaches cryptography."
		/>
	</head>

	<body>

		<Header />

		<main>

			<section class="hero">

				<p class="eyebrow">
					ABOUT THE CAVE
				</p>

				<h1>
					Cryptography deserves
					<span>deeper questions.</span>
				</h1>

				<p class="intro">
					CryptoCave is a living technical notebook for exploring
					cryptography from its mathematical foundations to modern
					protocols, implementations, experiments, and formal analysis.
				</p>

			</section>


			<section class="content">

				<div class="section-number">
					01
				</div>

				<div>
					<p class="label">
						WHY CRYPTOCAVE
					</p>

					<h2>
						Understanding before using.
					</h2>

					<p>
						Cryptographic constructions are often introduced
						as algorithms to apply: choose parameters, execute
						the protocol, obtain the result.
					</p>

					<p>
						CryptoCave takes a different approach. The objective
						is to understand the structure underneath the
						construction: why a particular algebraic setting is
						used, where the computational hardness comes from,
						which assumptions security depends on, and what changes
						when those assumptions are modified.
					</p>
				</div>

			</section>


			<section class="content">

				<div class="section-number">
					02
				</div>

				<div>
					<p class="label">
						THE SCOPE
					</p>

					<h2>
						From foundations to modern protocols.
					</h2>

					<div class="scope-grid">

						<span>Algebra</span>
						<span>Number Theory</span>
						<span>Symmetric Crypto</span>
						<span>Public-Key Crypto</span>
						<span>Zero Knowledge</span>
						<span>MPC</span>
						<span>Threshold Crypto</span>
						<span>Post-Quantum</span>
						<span>Formal Verification</span>
						<span>Implementations</span>

					</div>
				</div>

			</section>


			<section class="content">

				<div class="section-number">
					03
				</div>

				<div>
					<p class="label">
						THE METHOD
					</p>

					<h2>
						Theory. Implementation. Verification.
					</h2>

					<p>
						Articles are intended to connect mathematical intuition,
						formal reasoning, algorithms, code, experiments, and
						the current cryptographic research landscape.
					</p>

					<p>
						The site will continue to evolve as new questions,
						implementations, papers, experiments, and connections
						are explored.
					</p>

					<a
						class="github"
						href={GITHUB_URL}
						target="_blank"
						rel="noopener noreferrer"
					>
						Explore GitHub →
					</a>
				</div>

			</section>


			<section class="closing">

				<p>
					Do not stop at
					<strong>how.</strong>
				</p>

				<p>
					Keep asking
					<strong>why.</strong>
				</p>

			</section>

		</main>

		<Footer />

	</body>

</html>

<style>
	main {
		width: min(1000px, calc(100% - 3rem));

		margin: 0 auto;
	}

	.hero {
		padding: 8rem 0 6rem;

		border-bottom: 1px solid #e5e7eb;
	}

	.eyebrow,
	.label {
		margin: 0;

		font-family: monospace;
		font-size: 0.7rem;
		font-weight: 700;

		letter-spacing: 0.14em;

		color: #4f46e5;
	}

	h1 {
		max-width: 950px;

		margin: 1rem 0 2rem;

		font-size: clamp(3.5rem, 8vw, 7rem);

		line-height: 0.95;

		letter-spacing: -0.055em;

		color: #111827;
	}

	h1 span {
		display: block;

		color: #6b7280;
	}

	.intro {
		max-width: 760px;

		margin: 0;

		font-size: 1.15rem;
		line-height: 1.8;

		color: #6b7280;
	}

	.content {
		display: grid;
		grid-template-columns: 80px 1fr;

		gap: 2rem;

		padding: 5rem 0;

		border-bottom: 1px solid #e5e7eb;
	}

	.section-number {
		font-family: monospace;

		color: #9ca3af;
	}

	h2 {
		margin: 0.8rem 0 1.8rem;

		font-size: clamp(2rem, 5vw, 3.5rem);

		line-height: 1.05;

		letter-spacing: -0.04em;

		color: #111827;
	}

	.content p:not(.label) {
		max-width: 720px;

		font-size: 1.03rem;
		line-height: 1.85;

		color: #5f6875;
	}

	.scope-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);

		margin-top: 2rem;

		border-top: 1px solid #e5e7eb;
	}

	.scope-grid span {
		padding: 1.2rem 0;

		border-bottom: 1px solid #e5e7eb;

		font-weight: 600;

		color: #374151;
	}

	.scope-grid span:nth-child(odd) {
		padding-right: 2rem;
	}

	.github {
		display: inline-block;

		margin-top: 1.5rem;

		font-family: monospace;
		font-size: 0.8rem;
		font-weight: 700;

		color: #4f46e5;

		text-decoration: none;
	}

	.closing {
		padding: 7rem 0;
	}

	.closing p {
		margin: 0;

		font-size: clamp(2.5rem, 6vw, 5rem);

		line-height: 1.05;

		letter-spacing: -0.05em;

		color: #9ca3af;
	}

	.closing strong {
		color: #111827;
	}

	@media (max-width: 700px) {
		main {
			width: calc(100% - 2rem);
		}

		.hero {
			padding: 5rem 0 4rem;
		}

		.content {
			grid-template-columns: 1fr;
		}

		.section-number {
			display: none;
		}

		.scope-grid {
			grid-template-columns: 1fr;
		}

		.scope-grid span:nth-child(odd) {
			padding-right: 0;
		}
	}
</style>