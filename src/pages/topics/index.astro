---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';
import { TOPICS, TOPIC_GROUPS } from '../../data/topics';

const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
const topicData = TOPICS.map((topic) => ({
	...topic,
	count: posts.filter((post) => post.data.topics.includes(topic.name)).length,
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Topics | ${SITE_TITLE}`} description="Explore CryptoCave by cryptographic subject area." />
	</head>
	<body>
		<Header />
		<main>
			<section class="page-header">
				<p class="eyebrow">KNOWLEDGE MAP</p>
				<h1>Topics</h1>
				<p class="intro">
					Topics are subject areas, not reading order. One article may belong to several topics:
					for example, Coppersmith belongs to public-key cryptography, cryptanalysis, and lattice methods.
					Use <a href="/series/">Series</a> when you want the intended sequence.
				</p>
			</section>

			<section class="topics-section">
				{TOPIC_GROUPS.map((group, groupIndex) => {
					const topics = topicData.filter((topic) => topic.group === group);
					return (
						<section class="topic-group">
							<div class="group-heading">
								<span>{String(groupIndex + 1).padStart(2, '0')}</span>
								<h2>{group}</h2>
							</div>
							<div class="topic-grid">
								{topics.map((topic) => (
									<a class="topic-card" href={`/topics/${topic.slug}/`}>
										<div>
											<h3>{topic.name}</h3>
											<p>{topic.description}</p>
										</div>
										<span class:list={['count', { empty: topic.count === 0 }]}>
											{topic.count === 0 ? 'planned' : `${topic.count} ${topic.count === 1 ? 'article' : 'articles'}`}
										</span>
									</a>
								))}
							</div>
						</section>
					);
				})}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.topic-group {
		margin-bottom: 3rem;
	}
	.group-heading {
		justify-content: flex-start;
		gap: 0.8rem;
	}
	.group-heading > span {
		color: var(--green);
	}
	.topic-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
		gap: 0.6rem;
	}
	.topic-card {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 0.8rem;
		padding: 1rem 1.1rem;
	}
	.topic-card h3 {
		font-size: 0.95rem;
		margin-bottom: 0.35rem;
	}
	.topic-card p {
		color: var(--fg-dim);
		font-size: 0.86rem;
		line-height: 1.55;
		margin: 0;
	}
	.count {
		color: var(--green);
		font-size: 0.72rem;
	}
	.count.empty {
		color: var(--amber);
	}
</style>
