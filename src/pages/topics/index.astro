---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';
import { TOPICS, TOPIC_GROUPS } from '../../data/topics';

const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
const topicData = TOPICS.map((topic) => ({
	...topic,
	count: posts.filter((post) => post.data.topics.includes(topic.name)).length,
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Topics | ${SITE_TITLE}`} description="Explore CryptoCave by cryptographic subject area." />
	</head>
	<body>
		<Header />
		<main>
			<section class="page-header">
				<p class="eyebrow">KNOWLEDGE MAP</p>
				<h1>Topics</h1>
				<p class="intro">
					Topics are subject areas, not reading order. One article may belong to several topics:
					for example, Coppersmith belongs to public-key cryptography, cryptanalysis, and lattice methods.
					Use <a href="/series/">Series</a> when you want the intended sequence.
				</p>
			</section>

			<section class="topics-section">
				{TOPIC_GROUPS.map((group, groupIndex) => {
					const topics = topicData.filter((topic) => topic.group === group);
					return (
						<section class="topic-group">
							<div class="group-heading">
								<span>{String(groupIndex + 1).padStart(2, '0')}</span>
								<h2>{group}</h2>
							</div>
							<div class="topic-grid">
								{topics.map((topic) => (
									<a class="topic-card" href={`/topics/${topic.slug}/`}>
										<div>
											<h3>{topic.name}</h3>
											<p>{topic.description}</p>
										</div>
										<span class:list={['count', { empty: topic.count === 0 }]}>
											{topic.count === 0 ? 'planned' : `${topic.count} ${topic.count === 1 ? 'article' : 'articles'}`}
										</span>
									</a>
								))}
							</div>
						</section>
					);
				})}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main { width: 100%; }
	.page-header, .topics-section { width: min(1100px, calc(100% - 3rem)); margin: 0 auto; }
	.page-header { padding: 7rem 0 5rem; border-bottom: 1px solid #e5e7eb; }
	.eyebrow { margin: 0; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.13em; color: #4f46e5; }
	h1 { margin: 0.7rem 0 1.2rem; font-size: clamp(3.5rem, 8vw, 7rem); line-height: 0.95; letter-spacing: -0.055em; color: #111827; }
	.intro { max-width: 820px; margin: 0; font-size: 1.1rem; line-height: 1.8; color: #6b7280; }
	.intro a { color: #4f46e5; font-weight: 700; text-decoration: none; }
	.topics-section { padding: 4rem 0 7rem; }
	.topic-group + .topic-group { margin-top: 4rem; }
	.group-heading { display: flex; align-items: baseline; gap: 1rem; margin-bottom: 1rem; }
	.group-heading span { font-family: monospace; font-size: 0.7rem; color: #4f46e5; }
	.group-heading h2 { margin: 0; font-size: 1.4rem; color: #111827; }
	.topic-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid #d1d5db; }
	.topic-card { display: flex; flex-direction: column; justify-content: space-between; min-height: 210px; gap: 2rem; padding: 2rem; border-bottom: 1px solid #d1d5db; color: inherit; text-decoration: none; }
	.topic-card:nth-child(odd) { border-right: 1px solid #d1d5db; }
	.topic-card h3 { margin: 0 0 0.7rem; font-size: 1.35rem; letter-spacing: -0.02em; color: #111827; }
	.topic-card p { margin: 0; line-height: 1.65; color: #6b7280; }
	.count { font-family: monospace; font-size: 0.72rem; font-weight: 700; color: #4f46e5; }
	.count.empty { color: #9ca3af; }
	.topic-card:hover h3 { color: #4f46e5; }
	@media (max-width: 720px) { .topic-grid { grid-template-columns: 1fr; } .topic-card:nth-child(odd) { border-right: none; } }
</style>
